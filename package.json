    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "codemirror": "6.0.2",
    "js-beautify": "2.0.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.25.10",
    "tailwindcss": "4.3.3"
  }
