package httpui

import "strconv"
import "gopress/internal/i18n"
import "gopress/internal/store"
import "gopress/internal/ui/components/button"
import "gopress/internal/ui/components/card"
import "gopress/internal/ui/components/icon"


templ FAQList(site, csrf string, groups []store.FAQGroup, enabled bool) {
	@AdminLayout(site, i18n.T(ctx, "Модули"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "Вопросы и ответы"), len(groups)) {
			@button.Button(button.Props{Href: "/admin/modules", Size: button.SizeSm, Variant: button.VariantOutline}) {
				{ i18n.T(ctx,"Модули") }
			}
			@button.Button(button.Props{Href: "/admin/modules/faq/new", Size: button.SizeSm}) {
				@icon.Plus()<span>{ i18n.T(ctx,"Создать группу") }</span>
			}
		}
		if !enabled {
			<p class="notice">{ i18n.T(ctx,"FAQ отключён. Вы можете готовить ответы; на сайте они появятся после включения модуля.") }</p>
		}
		<div class="management-workspace">
			<div>
				if len(groups)==0 {
					<section class="empty-state"><h2>{ i18n.T(ctx,"Начните с первой группы") }</h2><p>{ i18n.T(ctx,"Например, оплата, доставка или работа сервиса. Каждую группу можно вставить отдельно.") }</p></section>
				}
				<div class="forms-list">
					for _,f:=range groups {
						<article class="forms-list-row">
							<div><a class="page-title" href={ templ.SafeURL(faqPath(f.ID)) }>{ f.Name }</a><p class="field-help">{ strconv.Itoa(len(f.Items)) } · FAQ</p></div><code>{ faqCode(f.ID) }</code>
							@button.Button(button.Props{Href: faqPath(f.ID), Size: button.SizeSm, Variant: button.VariantOutline}) {
								{ i18n.T(ctx,"Редактировать") }
							}
						</article>
					}
				</div>
			</div>
			<aside class="management-context"><h2>{ i18n.T(ctx,"Как добавить на сайт") }</h2><p>{ i18n.T(ctx,"Откройте группу и скопируйте код. Вставьте его отдельным абзацем в редакторе и опубликуйте материал.") }</p><p>{ i18n.T(ctx,"Ответы раскрываются по нажатию на вопрос. Цвета и шрифты наследуются от шаблона.") }</p></aside>
		</div>
	}
}

templ FAQEditor(site, csrf string, f store.FAQGroup, message string) {
	@AdminLayout(site, i18n.T(ctx, "Модули"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "Группа FAQ"), -1) {
			@button.Button(button.Props{Href: "/admin/modules/faq", Size: button.SizeSm, Variant: button.VariantOutline}) {
				{ i18n.T(ctx,"Все группы") }
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Form: "faq-editor", Size: button.SizeSm}) {
				{ i18n.T(ctx,"Сохранить") }
			}
		}
		if message!="" {
			<p class={ templ.KV("notice",true),templ.KV("notice-error",message!="Группа FAQ сохранена.") } role="status">{ i18n.T(ctx,message) }</p>
		}
		<div class="management-workspace">
			<form id="faq-editor" method="post" action="/admin/modules/faq/save" data-change-form data-faq-editor class="faq-editor">
				<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="id" value={ strconv.FormatInt(f.ID, 10) }/><input type="hidden" name="version" value={ strconv.FormatInt(f.Version, 10) }/>
				@card.Card(card.Props{Class: "settings-panel px-4"}) {
					<label>{ i18n.T(ctx,"Название группы") }<input class="site-input" name="name" required maxlength="120" value={ f.Name }/></label>
				}
				<div data-faq-items class="faq-items">
					for _,item:=range f.Items {
						@FAQItemEditor(item)
					}
				</div>
				@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-faq-add": true}}) {
					@icon.Plus()<span>{ i18n.T(ctx,"Добавить вопрос") }</span>
				}
				<p class="field-help" data-faq-status aria-live="polite">{ i18n.T(ctx,"До 50 вопросов. Порядок в редакторе совпадает с порядком на сайте.") }</p>
				<template data-faq-template>@FAQItemEditor(store.FAQItem{})</template>
			</form>
			<aside class="management-context">
				<h2>{ i18n.T(ctx,"Код для вставки") }</h2>
				if f.ID>0 {
					<input class="site-input" aria-label={ i18n.T(ctx, "Код для вставки") } readonly data-faq-code value={ faqCode(f.ID) }/>
				} else {
					<p>{ i18n.T(ctx,"Код появится после первого сохранения группы.") }</p>
				}
				<p>{ i18n.T(ctx,"Вставляйте код отдельным абзацем. Изменения ответов сразу появятся во всех материалах с этой группой.") }</p>
				<p>{ i18n.T(ctx,"Ответы — обычный текст. HTML и скрипты не выполняются.") }</p>
				if f.ID>0 {
					<form method="post" action="/admin/modules/faq/delete" hx-confirm={ i18n.T(ctx, "Удалить группу FAQ навсегда? Она исчезнет из всех материалов.") }>
						<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="id" value={ strconv.FormatInt(f.ID, 10) }/><input type="hidden" name="version" value={ strconv.FormatInt(f.Version, 10) }/>@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
	{ i18n.T(ctx,"Удалить группу") }
}
					</form>
				}
			</aside>
		</div>
	}
}

templ FAQItemEditor(item store.FAQItem) {
	@card.Card(card.Props{Class: "settings-panel px-4 faq-item"}) {
		<div class="faq-item-heading">
			<span class="field-help">FAQ</span>
			<div class="flex gap-2">
				@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"data-faq-up": true, "aria-label": i18n.T(ctx, "Выше"), "title": i18n.T(ctx, "Выше")}}) {
					@icon.ArrowLeft(icon.Props{Class: "size-4 rotate-90"})
				}
				@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"data-faq-down": true, "aria-label": i18n.T(ctx, "Ниже"), "title": i18n.T(ctx, "Ниже")}}) {
					@icon.ArrowRight(icon.Props{Class: "size-4 rotate-90"})
				}
				@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"data-faq-remove": true, "aria-label": i18n.T(ctx, "Удалить вопрос"), "title": i18n.T(ctx, "Удалить вопрос")}}) {
					@icon.Icon("trash-2")()
				}
			</div>
		</div>
		<label>{ i18n.T(ctx,"Вопрос") }<input class="site-input" name="question" required maxlength="300" value={ item.Question }/></label>
		<label>{ i18n.T(ctx,"Ответ") }<textarea class="site-input" name="answer" required maxlength="5000" rows="4">{ item.Answer }</textarea></label>
	}
}

templ PublicFAQ(f store.FAQGroup) {
	<link rel="stylesheet" href="/assets/faq.css"/>
	<section class="gp-faq" aria-label={ f.Name }>
		<h2>{ f.Name }</h2>
		for _,item:=range f.Items {
			<details><summary>{ item.Question }</summary><div class="gp-faq-answer">{ item.Answer }</div></details>
		}
	</section>
}
