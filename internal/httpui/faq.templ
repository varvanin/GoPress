package httpui

import "strconv"
import "gopress/internal/i18n"
import "gopress/internal/store"
import "gopress/internal/ui/components/button"
import "gopress/internal/ui/components/card"
import "gopress/internal/ui/components/icon"


templ FAQList(site, csrf string, groups []store.FAQGroup, enabled bool) {
	@AdminLayout(site, i18n.T(ctx, "Modules"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "Questions and answers"), len(groups)) {
			@button.Button(button.Props{Href: "/admin/modules", Size: button.SizeSm, Variant: button.VariantOutline}) {
				{ i18n.T(ctx,"Modules") }
			}
			@button.Button(button.Props{Href: "/admin/modules/faq/new", Size: button.SizeSm}) {
				@icon.Plus()<span>{ i18n.T(ctx,"Create group") }</span>
			}
		}
		if !enabled {
			<p class="notice">{ i18n.T(ctx,"FAQ is disabled. Prepare answers now; they will appear on the site when you enable the module.") }</p>
		}
		<div class="management-workspace">
			<div>
				if len(groups)==0 {
					<section class="empty-state"><h2>{ i18n.T(ctx,"Create your first group") }</h2><p>{ i18n.T(ctx,"For example, payments, delivery or your service. Each group can be embedded separately.") }</p></section>
				}
				<div class="forms-list">
					for _,f:=range groups {
						<article class="forms-list-row">
							<div><a class="page-title" href={ templ.SafeURL(faqPath(f.ID)) }>{ f.Name }</a><p class="field-help">{ strconv.Itoa(len(f.Items)) } · FAQ</p></div><code>{ faqCode(f.ID) }</code>
							@button.Button(button.Props{Href: faqPath(f.ID), Size: button.SizeSm, Variant: button.VariantOutline}) {
								{ i18n.T(ctx,"Edit") }
							}
						</article>
					}
				</div>
			</div>
			<aside class="management-context"><h2>{ i18n.T(ctx,"How to add to your site") }</h2><p>{ i18n.T(ctx,"Open a group and copy its code. Paste it as a separate paragraph in the editor and publish.") }</p><p>{ i18n.T(ctx,"Click a question to reveal its answer. Colors and fonts follow the template.") }</p></aside>
		</div>
	}
}

templ FAQEditor(site, csrf string, f store.FAQGroup, message string) {
	@AdminLayout(site, i18n.T(ctx, "Modules"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "FAQ group"), -1) {
			@button.Button(button.Props{Href: "/admin/modules/faq", Size: button.SizeSm, Variant: button.VariantOutline}) {
				{ i18n.T(ctx,"All groups") }
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Form: "faq-editor", Size: button.SizeSm}) {
				{ i18n.T(ctx,"Save") }
			}
		}
		if message!="" {
			<p class={ templ.KV("notice",true),templ.KV("notice-error",message!="FAQ group saved.") } role="status">{ i18n.T(ctx,message) }</p>
		}
		<div class="management-workspace">
			<form id="faq-editor" method="post" action="/admin/modules/faq/save" data-change-form data-faq-editor class="faq-editor">
				<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="id" value={ strconv.FormatInt(f.ID, 10) }/><input type="hidden" name="version" value={ strconv.FormatInt(f.Version, 10) }/>
				@card.Card(card.Props{Class: "settings-panel px-4"}) {
					<label>{ i18n.T(ctx,"Group name") }<input class="site-input" name="name" required maxlength="120" value={ f.Name }/></label>
				}
				<div data-faq-items class="faq-items">
					for _,item:=range f.Items {
						@FAQItemEditor(item)
					}
				</div>
				@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-faq-add": true}}) {
					@icon.Plus()<span>{ i18n.T(ctx,"Add question") }</span>
				}
				<p class="field-help" data-faq-status aria-live="polite">{ i18n.T(ctx,"Up to 50 questions. The editor order matches the site.") }</p>
				<template data-faq-template>@FAQItemEditor(store.FAQItem{})</template>
			</form>
			<aside class="management-context">
				<h2>{ i18n.T(ctx,"Embed code") }</h2>
				if f.ID>0 {
					<input class="site-input" aria-label={ i18n.T(ctx, "Embed code") } readonly data-faq-code value={ faqCode(f.ID) }/>
				} else {
					<p>{ i18n.T(ctx,"The code appears after you save the group.") }</p>
				}
				<p>{ i18n.T(ctx,"Paste the code as a separate paragraph. Answer changes appear immediately in all content using this group.") }</p>
				<p>{ i18n.T(ctx,"Answers use plain text. HTML and scripts are not executed.") }</p>
				if f.ID>0 {
					<form method="post" action="/admin/modules/faq/delete" hx-confirm={ i18n.T(ctx, "Permanently delete this FAQ group? It will disappear from all content.") }>
						<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="id" value={ strconv.FormatInt(f.ID, 10) }/><input type="hidden" name="version" value={ strconv.FormatInt(f.Version, 10) }/>@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
	{ i18n.T(ctx,"Delete group") }
}
					</form>
				}
			</aside>
		</div>
	}
}

templ FAQItemEditor(item store.FAQItem) {
	@card.Card(card.Props{Class: "settings-panel px-4 faq-item"}) {
		<div class="faq-item-heading">
			<span class="field-help">FAQ</span>
			<div class="flex gap-2">
				@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"data-faq-up": true, "aria-label": i18n.T(ctx, "Move up"), "title": i18n.T(ctx, "Move up")}}) {
					@icon.ArrowLeft(icon.Props{Class: "size-4 rotate-90"})
				}
				@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"data-faq-down": true, "aria-label": i18n.T(ctx, "Move down"), "title": i18n.T(ctx, "Move down")}}) {
					@icon.ArrowRight(icon.Props{Class: "size-4 rotate-90"})
				}
				@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"data-faq-remove": true, "aria-label": i18n.T(ctx, "Delete question"), "title": i18n.T(ctx, "Delete question")}}) {
					@icon.Icon("trash-2")()
				}
			</div>
		</div>
		<label>{ i18n.T(ctx,"Question") }<input class="site-input" name="question" required maxlength="300" value={ item.Question }/></label>
		<label>{ i18n.T(ctx,"Answer") }<textarea class="site-input" name="answer" required maxlength="5000" rows="4">{ item.Answer }</textarea></label>
	}
}

templ PublicFAQ(f store.FAQGroup) {
	<link rel="stylesheet" href="/assets/faq.css"/>
	<section class="gp-faq" aria-label={ f.Name }>
		<h2>{ f.Name }</h2>
		for _,item:=range f.Items {
			<details><summary>{ item.Question }</summary><div class="gp-faq-answer">{ item.Answer }</div></details>
		}
	</section>
}
