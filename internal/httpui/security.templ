package httpui

import "strconv"
import "gopress/internal/i18n"
import "gopress/internal/service"
import "gopress/internal/store"
import "gopress/internal/ui/components/button"
import "gopress/internal/ui/components/card"
import "gopress/internal/ui/components/input"

templ AccountSecurity(site,csrf,zone string,user store.User,factor service.TwoFactorStatus,sessions []store.SessionInfo,total int,message string) {
 @AdminLayout(site,i18n.T(ctx,"My profile"),csrf) {
 @AdminPageHeader(i18n.T(ctx,"Security and sessions"),-1) {
 @button.Button(button.Props{Href:"/admin/account",Variant:button.VariantOutline,Size:button.SizeSm}) {<span>{ i18n.T(ctx,"My profile") }</span>}
 }
 if message!="" {
 <p class="notice notice-error" role="alert">{ i18n.T(ctx,message) }</p>
 }
 <div class="security-workspace">
 @card.Card(card.Props{Class:"settings-panel"}) {
 <h2>{ i18n.T(ctx,"Two-factor authentication") }</h2>
 <p>{ user.Email }</p>
 if factor.Enabled {
 <p>{ i18n.T(ctx,"2FA enabled") }</p>
 <p class="field-help">{ i18n.T(ctx,"Recovery codes remaining: ")+strconv.Itoa(factor.RecoveryCount) }</p>
 if factor.Unavailable {
 <p class="notice notice-error">{ i18n.T(ctx,"2FA key unavailable. Use a recovery code or server recovery.") }</p>
 }
 <form method="post" action="/admin/account/2fa/change" hx-boost="false">
 <input type="hidden" name="csrf" value={ csrf }/>
 @FactorPasswordAndCode(true)
 <div class="editor-block-actions">
 @button.Button(button.Props{Type:button.TypeSubmit,Variant:button.VariantOutline,Size:button.SizeSm,Attributes:templ.Attributes{"name":"action","value":"rotate"}}) {<span>{ i18n.T(ctx,"New recovery codes") }</span>}
 @button.Button(button.Props{Type:button.TypeSubmit,Variant:button.VariantGhost,Size:button.SizeSm,Attributes:templ.Attributes{"name":"action","value":"disable"}}) {<span>{ i18n.T(ctx,"Disable 2FA") }</span>}
 </div>
 </form>
 } else {
 <p class="field-help">{ i18n.T(ctx,"Add the key to your authenticator app, then confirm a fresh code. The key and recovery codes download separately and are never shown on the page.") }</p>
 <form method="post" action="/admin/account/2fa/setup" hx-boost="false">
 <input type="hidden" name="csrf" value={ csrf }/>
 @FactorPasswordAndCode(false)
 @button.Button(button.Props{Type:button.TypeSubmit,Variant:button.VariantOutline,Size:button.SizeSm}) {<span>{ i18n.T(ctx,"Download setup key") }</span>}
 </form>
 <form method="post" action="/admin/account/2fa/enable" hx-boost="false">
 <input type="hidden" name="csrf" value={ csrf }/>
 @FactorPasswordAndCode(true)
 @button.Button(button.Props{Type:button.TypeSubmit,Variant:button.VariantOutline,Size:button.SizeSm}) {<span>{ i18n.T(ctx,"Enable 2FA") }</span>}
 </form>
 }
 <p class="field-help">{ i18n.T(ctx,"Each code is single use. Sign in again after changing security settings.") }</p>
 <a class="context-link" href="/login" hx-boost="false">{ i18n.T(ctx,"Sign in") }</a>
 }
 @card.Card(card.Props{Class:"settings-panel"}) {
 <h2>{ i18n.T(ctx,"Active sessions") }<span class="content-count">{ strconv.Itoa(total) }</span></h2>
 if total>len(sessions) {
 <p class="field-help">{ i18n.T(ctx,"Sessions shown: ")+strconv.Itoa(len(sessions)) }</p>
 }
 <ul class="security-sessions">
 for _,session:=range sessions {
 <li><div>
 if session.Current {
 <strong>{ i18n.T(ctx,"This session") }</strong>
 } else {
 <strong>{ i18n.T(ctx,"Session") }</strong>
 }
 if session.UserAgent!="" {
 <p class="field-help session-agent">{ session.UserAgent }</p>
 }
 <p class="field-help">{ i18n.T(ctx,"Created: ")+tableContentDate(session.CreatedAt,zone) }</p>
 <p class="field-help">{ i18n.T(ctx,"Expires: ")+tableContentDate(session.ExpiresAt,zone) }</p>
 </div><form method="post" action="/admin/account/sessions/revoke"><input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="reference" value={ session.Reference }/>
 @button.Button(button.Props{Type:button.TypeSubmit,Variant:button.VariantGhost,Size:button.SizeSm}) {<span>{ i18n.T(ctx,"End session") }</span>}
 </form></li>
 }
 </ul>
 if total>1 {
 <form method="post" action="/admin/account/sessions/revoke"><input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="others" value="true"/>
 @button.Button(button.Props{Type:button.TypeSubmit,Variant:button.VariantOutline,Size:button.SizeSm}) {<span>{ i18n.T(ctx,"End other sessions") }</span>}
 </form>
 }
 }
 </div>
 }
}

templ FactorPasswordAndCode(code bool) {
 <label>{ i18n.T(ctx,"Current password") }@input.Input(input.Props{Name:"password",Type:"password",Required:true,Attributes:templ.Attributes{"autocomplete":"current-password","maxlength":"72"}})</label>
 if code {
 <label>{ i18n.T(ctx,"Fresh 2FA code or recovery code") }@input.Input(input.Props{Name:"code",Required:true,Attributes:templ.Attributes{"autocomplete":"one-time-code","maxlength":"64"}})</label>
 }
}
