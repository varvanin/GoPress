package httpui

import "gopress/internal/ui/components/icon"

import "gopress/internal/i18n"

import "strconv"
import "gopress/internal/store"
import "gopress/internal/service"
import "gopress/internal/ui/components/button"
import "gopress/internal/ui/components/input"
import "gopress/internal/ui/components/card"
import selectcomp "gopress/internal/ui/components/select"

templ SettingsPage(site, csrf, tab string, value store.Settings, mail service.MailSettings, pages []store.Page, message string, failed, dirty bool) {
	@AdminLayout(site, i18n.T(ctx, "Settings"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "Settings"), -1) {
			if tab!="mail"||!mail.Environment {
				@button.Button(button.Props{Type: button.TypeSubmit, Form: "site-settings-form", Size: button.SizeSm}) {
					{ i18n.T(ctx,"Save settings") }
				}
			}
		}
		@SettingsTabs(tab)
		if message!="" {
			<p class={ "notice",templ.KV("notice-error",failed) } role="status">{ i18n.T(ctx, message) }</p>
		}
		<div class="management-workspace settings-workspace">
			<div class="site-settings">
				if tab=="mail" {
					if mail.Environment {
						<p class="field-help">{ i18n.T(ctx,"Email is configured through server environment variables. Change them on the server; test delivery here.") }</p>
					} else {
						<form id="site-settings-form" method="post" action="/admin/settings/mail" data-change-form data-form-dirty={ strconv.FormatBool(dirty) }>
							<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="mail_version" value={ mail.Version }/>
							@card.Card(card.Props{Class: "settings-panel px-4"}) {
								<h2>{ i18n.T(ctx,"Outgoing email") }</h2>
								<label>
									{ i18n.T(ctx,"Email notifications") }
									@AdminSelect("mail-enabled", "enabled", strconv.FormatBool(mail.Enabled), i18n.T(ctx, "Email notifications"), []selectcomp.ItemData{{Value: "true", Label: i18n.T(ctx, "Enabled")}, {Value: "false", Label: i18n.T(ctx, "Disabled")}}, nil)
								</label>
								<div class="settings-pair">
									<label>
										{ i18n.T(ctx,"SMTP server") }
										@input.Input(input.Props{Name: "host", Value: mail.Host, Placeholder: "smtp.example.com", Attributes: templ.Attributes{"maxlength": "253", "autocomplete": "off"}})
									</label>
									<label>
										{ i18n.T(ctx,"Port") }
										@input.Input(input.Props{Name: "port", Type: "number", Value: mail.Port, Required: true, Attributes: templ.Attributes{"min": "1", "max": "65535"}})
									</label>
								</div>
								<p class="field-help">{ i18n.T(ctx,"Port 587 uses STARTTLS, 465 uses TLS. Connections are encrypted and certificates verified.") }</p>
								<label>
									{ i18n.T(ctx,"Sender address") }
									@input.Input(input.Props{Name: "from", Type: "email", Value: mail.From, Placeholder: "website@example.com", Attributes: templ.Attributes{"maxlength": "254"}})
								</label>
								<label>
									{ i18n.T(ctx,"SMTP username") }
									@input.Input(input.Props{Name: "username", Value: mail.Username, Attributes: templ.Attributes{"autocomplete": "off", "maxlength": "254"}})
								</label>
								<label>
									{ i18n.T(ctx,"SMTP password") }
									@input.Input(input.Props{Name: "password", Type: "password", Placeholder: i18n.T(ctx, "New password"), Attributes: templ.Attributes{"autocomplete": "new-password", "maxlength": "4096"}})
								</label>
								if mail.Password!="" {
									<p class="field-help">{ i18n.T(ctx,"A password is saved. Leave the field empty to keep it.") }</p>
									<label class="settings-checkbox"><input type="checkbox" name="clear_password" value="1"/> { i18n.T(ctx,"Remove saved password") }</label>
								}
								<p class="field-help">{ i18n.T(ctx,"Each form has its own recipient. Save settings before sending a test email.") }</p>
							}
						</form>
					}
					@card.Card(card.Props{Class: "settings-panel px-4"}) {
						<h2>{ i18n.T(ctx,"Delivery test") }</h2>
						if mail.Environment {
							<p class="field-help">{ mail.Host+":"+mail.Port+" · "+mail.From }</p>
						}
						<form method="post" action="/admin/settings/mail-test" class="mail-test-form">
							<input type="hidden" name="csrf" value={ csrf }/>
							<label>
								{ i18n.T(ctx,"Test email recipient") }
								@input.Input(input.Props{Name: "test_recipient", Type: "email", Required: true, Placeholder: "you@example.com", Attributes: templ.Attributes{"maxlength": "254"}})
							</label>
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
								{ i18n.T(ctx,"Send test email") }
							}
						</form>
					}
				} else {
					<form id="site-settings-form" method="post" action={ templ.SafeURL("/admin/settings/" + tab) } data-change-form data-form-dirty={ strconv.FormatBool(dirty) }>
						<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="version" value={ strconv.FormatInt(value.Version, 10) }/>
						@card.Card(card.Props{Class: "settings-panel px-4"}) {
							switch tab {
								case "general":
									<h2>{ i18n.T(ctx,"General settings") }</h2>
									<label>
										{ i18n.T(ctx,"Site name") }
										@input.Input(input.Props{Name: "title", Value: value.Site.Title, Required: true, Attributes: templ.Attributes{"maxlength": "200"}})
									</label>
									<label>{ i18n.T(ctx,"Site description") }<textarea name="description" class="site-input" maxlength="500" rows="3">{ value.Description }</textarea></label>
									<label>
										{ i18n.T(ctx,"Site URL") }
										@input.Input(input.Props{Name: "base_url", Type: "url", Value: value.Site.BaseURL, Required: true, Placeholder: "https://example.com", Attributes: templ.Attributes{"maxlength": "2048"}})
									</label>
									<p class="field-help">{ i18n.T(ctx,"Primary address without a path. After changing it, use the new URL to open the site and admin panel.") }</p>
									<label>
										{ i18n.T(ctx,"Time zone") }
										@input.Input(input.Props{Name: "timezone", Value: value.Site.Timezone, Required: true, Placeholder: "Europe/Warsaw", Attributes: templ.Attributes{"maxlength": "100"}})
									</label>
									<p class="field-help">{ i18n.T(ctx,"An IANA name such as Europe/Warsaw or Europe/Moscow. Existing scheduled publication times stay unchanged.") }</p>
								case "home":
									<h2>{ i18n.T(ctx,"Homepage") }</h2>
									<label>
										{ i18n.T(ctx,"Show on homepage") }
										@AdminSelect("home-mode", "home_mode", value.HomeMode, i18n.T(ctx, "Homepage content"), []selectcomp.ItemData{{Value: "posts", Label: i18n.T(ctx, "Posts feed")}, {Value: "page", Label: i18n.T(ctx, "Selected page")}}, nil)
									</label>
									<label>
										{ i18n.T(ctx,"Published page") }
										@AdminSelect("home-page", "home_page_id", strconv.FormatInt(value.HomePageID, 10), i18n.T(ctx, "Homepage"), homePageItems(ctx, pages, value.HomePageID), nil)
									</label>
									<p class="field-help">{ i18n.T(ctx,"Used only in selected page mode. If the page is unpublished or deleted, the site shows the posts feed.") }</p>
									<label>
										{ i18n.T(ctx,"Posts per page") }
										@input.Input(input.Props{Name: "posts_per_page", Type: "number", Value: strconv.Itoa(value.PostsPerPage), Required: true, Attributes: templ.Attributes{"min": "1", "max": "100"}})
									</label>
									<p class="field-help">{ i18n.T(ctx,"From 1 to 100. Controls the feed and pagination; the active template defines its appearance.") }</p>
								case "language":
									<h2>{ i18n.T(ctx,"Interface language") }</h2>
									<label>
										{ i18n.T(ctx,"Admin panel language") }
										@AdminSelect("admin-language", "language", value.Language, i18n.T(ctx, "Admin panel language"), materialLanguages(), nil)
									</label>
									<p class="field-help">{ i18n.T(ctx,"Applies to the admin panel and sign-in page. Published content and the site template keep their language.") }</p>
							}
						}
					</form>
				}
			</div>
			<aside class="management-context">
				<h2>{ i18n.T(ctx,"Site information") }</h2>
				<dl class="context-definitions">
					<div><dt>{ i18n.T(ctx,"Site URL") }</dt><dd>{ value.Site.BaseURL }</dd></div>
					<div><dt>{ i18n.T(ctx,"Time zone") }</dt><dd>{ value.Site.Timezone }</dd></div>
					<div>
						<dt>{ i18n.T(ctx,"Homepage") }</dt>
						<dd>
							if value.HomeMode=="page" {
								{ i18n.T(ctx,"Selected page") }
							} else {
								{ i18n.T(ctx,"Posts feed") }
							}
						</dd>
					</div>
					<div>
						<dt>{ i18n.T(ctx,"Email") }</dt>
						<dd>
							if mail.Configured() {
								{ i18n.T(ctx,"Configured") }
							} else {
								{ i18n.T(ctx,"Not configured") }
							}
						</dd>
					</div>
				</dl>
				<p>{ i18n.T(ctx,"Each section saves separately. Review changes before saving; published content is not changed automatically.") }</p>
			</aside>
		</div>
	}
}


templ SettingsTabs(tab string) {
		<nav class="content-list-tabs settings-tabs" aria-label={ i18n.T(ctx, "Settings sections") }>
			<a href="/admin/settings?tab=general" aria-current={ activeTab(tab == "general") }>@icon.Icon("settings-2")(icon.Props{Class:"size-3.5"})<span>{ i18n.T(ctx,"General") }</span></a>
			<a href="/admin/settings?tab=home" aria-current={ activeTab(tab == "home") }>@icon.Icon("house")(icon.Props{Class:"size-3.5"})<span>{ i18n.T(ctx,"Homepage") }</span></a>
			<a href="/admin/settings?tab=mail" aria-current={ activeTab(tab == "mail") }>@icon.Icon("mail")(icon.Props{Class:"size-3.5"})<span>{ i18n.T(ctx,"Email") }</span></a>
			<a href="/admin/ai" aria-current={ activeTab(tab == "ai") }>@icon.Icon("bot")(icon.Props{Class:"size-3.5"})<span>{ i18n.T(ctx,"AI") }</span></a>
<a href="/admin/settings?tab=language" aria-current={ activeTab(tab == "language") }>@icon.Icon("languages")(icon.Props{Class:"size-3.5"})<span>{ i18n.T(ctx,"Interface language") }</span></a>
			<a href="/admin/updates" aria-current={activeTab(tab=="updates")}>@icon.Icon("refresh-cw")(icon.Props{Class:"size-3.5"})<span>{ i18n.T(ctx,"Updates") }</span></a>
		</nav>
}
