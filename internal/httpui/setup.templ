package httpui
import "gopress/internal/i18n"
import "gopress/internal/ui/components/icon"
import "gopress/internal/ui/components/card"
templ SetupPage(site,csrf string,steps []SetupStep){
 @AdminLayout(site,i18n.T(ctx,"Overview"),csrf){
 @AdminPageHeader(i18n.T(ctx,"Getting started"),-1){}
 @card.Card(card.Props{Class:"settings-panel"}){
 <ul class="security-sessions">
 for _,step:=range steps {
 <li><a class="context-link" href={ templ.SafeURL(step.URL) }>{ i18n.T(ctx,step.Label) }</a>
 if step.Done {
 <span class="field-help">@icon.Check(icon.Props{Class:"size-4"})<span>{ i18n.T(ctx,"Done") }</span></span>
 } else {
 <span class="field-help">{ i18n.T(ctx,"Incomplete") }</span>
 }
 </li>
 }
 </ul>
 <p class="field-help">{ i18n.T(ctx,"Statuses reflect site data. Configure menus, email and two-factor authentication as needed.") }</p>
 <nav class="seo-resource-links"><a href="/admin/menus">{ i18n.T(ctx,"Menus") }</a><a href="/admin/settings?tab=mail">{ i18n.T(ctx,"Email") }</a><a href="/admin/account/security">{ i18n.T(ctx,"Security and sessions") }</a></nav>
 }
 }
}
