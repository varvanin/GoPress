package httpui

import "gopress/internal/i18n"

import "strconv"
import "strings"
import "net/url"
import "gopress/internal/store"
import "gopress/internal/service"
import "gopress/internal/ui/components/button"
import "gopress/internal/ui/components/icon"
import "gopress/internal/ui/components/card"
import selectcomp "gopress/internal/ui/components/select"

templ Forms(site, csrf string, forms []store.Form, smtp bool,settings store.Settings) {
	@AdminLayout(site, i18n.T(ctx, "Forms"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "Forms"), len(forms)) {
			@button.Button(button.Props{Href: "/admin/forms/new", Size: button.SizeSm}) {
				@icon.Plus()<span>{ i18n.T(ctx,"Create form") }</span>
			}
		}
		<div class="management-workspace forms-workspace">
			<div>
				if len(forms)==0 {
					@card.Card(card.Props{Class: "forms-empty"}) {
						@icon.FileText(icon.Props{Class: "size-6"})
						<h2>{ i18n.T(ctx,"Create your first form") }</h2>
						<p>{ i18n.T(ctx,"Add fields, set a recipient email and paste the shortcode into a page or post.") }</p>
					}
				}
		<div class="forms-list">
			for _, f := range forms {
				<article class="forms-list-row">
					<div>
						<a
							class="page-title"
							href={ templ.SafeURL(formPath(f.ID) + "/edit") }
						>{ f.Name }</a>
						<p class="field-help">
							if f.Enabled {
								<span>{ i18n.T(ctx,"Active") }</span>
							} else {
								<span>{ i18n.T(ctx,"Disabled") }</span>
							}
							<span>· { f.Recipient }</span>
						</p>
					</div>
					<code>
						{ formCode(f.ID) }
					</code>
					<div class="flex gap-2">
						@button.Button(button.Props{Href: formPath(f.ID) + "/entries", Variant: button.VariantOutline, Size: button.SizeSm}) {
							{ i18n.T(ctx,"Submissions") }
						}
						@button.Button(button.Props{Href: formPath(f.ID) + "/edit", Variant: button.VariantGhost, Size: button.SizeSm}) {
							{ i18n.T(ctx,"Edit") }
						}
					</div>
				</article>
			}
		</div>
			</div>
			<aside class="forms-context">
				@card.Card(card.Props{Class: "forms-retention"}) {
					<h2>@icon.Icon("database")(icon.Props{Class: "size-4"})<span>{ i18n.T(ctx,"Submissions") }</span></h2>
					<form method="post" action="/admin/forms/retention" data-change-form>
						<input type="hidden" name="csrf" value={ csrf }/>
						<input type="hidden" name="version" value={ strconv.FormatInt(settings.Version,10) }/>
						<label for="form-retention-days">{ i18n.T(ctx,"Submission retention, days") }</label>
						<input id="form-retention-days" type="number" name="days" class="site-input" required min="1" max="3650" value={ strconv.Itoa(settings.FormRetentionDays) }/>
						<p class="field-help">{ i18n.T(ctx,"Submissions older than this period and their queued notifications are deleted automatically.") }</p>
						@button.Button(button.Props{Type:button.TypeSubmit,Size:button.SizeSm,Variant:button.VariantOutline}) {
							{ i18n.T(ctx,"Save") }
						}
					</form>
				}
				if !smtp {
					<div class="forms-mail-status">
						<p class="field-help">{ i18n.T(ctx,"Email notifications are not configured. Submissions are saved in the admin panel.") }</p>
						<a href="/admin/settings?tab=mail" class="context-link">{ i18n.T(ctx,"Configure email") }</a>
					</div>
				}
			</aside>
		</div>
	}
}

templ FormEditor(site, csrf string, f store.Form, message string) {
	@AdminLayout(site, i18n.T(ctx, "Forms"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "Form builder"), -1) {
			@button.Button(button.Props{Href: "/admin/forms", Variant: button.VariantOutline, Size: button.SizeSm}) {
				{ i18n.T(ctx,"All forms") }
			}
			if f.ID>0 {
				@button.Button(button.Props{Href: formPath(f.ID) + "/entries", Variant: button.VariantOutline, Size: button.SizeSm}) {
					{ i18n.T(ctx,"Submissions") }
				}
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Form: "form-builder", Size: button.SizeSm}) {
				{ i18n.T(ctx,"Save form") }
			}
		}
		if message!="" {
			<p class={ templ.KV("notice",true), templ.KV("notice-error",message!="Form saved.") } role="status">{ i18n.T(ctx, message) }</p>
		}
		if f.ID>0 {
			@card.Card(card.Props{Class: "form-embed settings-panel px-4"}) {
				<label for="form-code">{ i18n.T(ctx,"Embed code") }</label>
				<div class="flex gap-2">
					<input
						id="form-code"
						class="site-input"
						value={ formCode(f.ID) }
						readonly
					/><button type="button" data-copy-form class="form-copy">{ i18n.T(ctx,"Copy") }</button>
				</div>
				<p class="field-help">{ i18n.T(ctx,"Paste this code as a separate paragraph in a page or post. The published page will display the form.") }</p><a
	class="text-xs underline"
	href={ templ.SafeURL("/forms/" + strconv.FormatInt(f.ID, 10)) }
	target="_blank"
	rel="noopener"
>{ i18n.T(ctx,"Open saved form ↗") }</a>
			}
		}
		<div class="form-builder-layout">
			<form id="form-builder" action="/admin/forms/save" method="post" data-form-builder data-change-form class="form-builder">
				<input type="hidden" name="csrf" value={ csrf }/><input
	type="hidden"
	name="id"
	value={ strconv.FormatInt(f.ID, 10) }
/><input
	type="hidden"
	name="version"
	value={ strconv.FormatInt(f.Version, 10) }
/>
				@card.Card(card.Props{Class: "settings-panel form-settings px-4"}) {
					<h2>{ i18n.T(ctx,"Settings") }</h2>
					<label>{ i18n.T(ctx,"Form name") }<input class="site-input" name="name" required maxlength="120" value={ f.Name } placeholder={ i18n.T(ctx, "Contact") }/></label>
					<label>{ i18n.T(ctx,"Recipient email") }<input class="site-input" name="recipient" type="email" required maxlength="254" value={ f.Recipient } placeholder="mail@example.com"/></label>
					<div class="form-setting-pair">
						<label>{ i18n.T(ctx,"Button label") }<input class="site-input" name="button" required maxlength="80" value={ f.Button }/></label>
						<label>
							{ i18n.T(ctx,"State") }
							@AdminSelect("form-enabled", "enabled", strconv.FormatBool(f.Enabled), i18n.T(ctx, "Form state"), []selectcomp.ItemData{{Value: "true", Label: i18n.T(ctx, "Active")}, {Value: "false", Label: i18n.T(ctx, "Disabled")}}, nil)
						</label>
					</div>
					<label>{ i18n.T(ctx,"Success message") }<textarea class="site-input" name="success" required maxlength="500" rows="2">{ f.Success }</textarea></label>
				}
				@card.Card(card.Props{Class: "settings-panel form-fields-panel px-4"}) {
					<div class="flex items-center justify-between gap-2"><h2>{ i18n.T(ctx,"Form fields") }</h2><span class="field-help">{ i18n.T(ctx,"Up to 20 fields") }</span></div>
					<div data-form-fields class="form-fields">
						for _, field := range f.Fields {
							@FormFieldEditor(field)
						}
					</div>
					@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-add-form-field": true}}) {
						@icon.Plus()<span>{ i18n.T(ctx,"Add field") }</span>
					}
					<p class="field-help" data-form-builder-status aria-live="polite"></p>
				}
				<template data-form-field-template>@FormFieldEditor(store.FormField{Type: "text", Label: i18n.T(ctx, "New field")})</template>
			</form>
			@card.Card(card.Props{Class: "settings-panel form-preview px-4"}) {
				<h2>{ i18n.T(ctx,"Preview") }</h2>
				<p class="field-help">{ i18n.T(ctx,"This is how visitors will see the fields. Submission is available after saving.") }</p>
				<div data-form-preview></div>
			}
		</div>
	}
}

templ FormFieldEditor(field store.FormField) {
	<div class="form-field-editor" data-form-field>
		<div class="form-field-heading"><label>{ i18n.T(ctx,"Field label") }<input class="site-input" name="field_label" value={ field.Label } required maxlength="120"/></label><div class="form-field-actions"><button type="button" data-form-field-up aria-label={ i18n.T(ctx, "Move field up") } title={ i18n.T(ctx, "Move up") }>@icon.ArrowLeft(icon.Props{Class: "size-4 rotate-90"})</button><button type="button" data-form-field-down aria-label={ i18n.T(ctx, "Move field down") } title={ i18n.T(ctx, "Move down") }>@icon.ArrowRight(icon.Props{Class: "size-4 rotate-90"})</button><button type="button" data-remove-form-field aria-label={ i18n.T(ctx, "Remove field") } title={ i18n.T(ctx, "Remove field") }>@icon.Icon("trash-2")(icon.Props{Class: "size-4"})</button></div></div>
		<div class="form-setting-pair">
			<label>
				{ i18n.T(ctx,"Type") }
				@AdminSelect("", "field_type", field.Type, i18n.T(ctx, "Field type"), []selectcomp.ItemData{{Value: "text", Label: i18n.T(ctx, "Text")}, {Value: "email", Label: "Email"}, {Value: "tel", Label: i18n.T(ctx, "Phone")}, {Value: "textarea", Label: i18n.T(ctx, "Message")}, {Value: "select", Label: i18n.T(ctx, "Dropdown")}, {Value: "checkbox", Label: i18n.T(ctx, "Checkbox / consent")}}, nil)
			</label>
			<label>
				{ i18n.T(ctx,"Requirement") }
				@AdminSelect("", "field_required", strconv.FormatBool(field.Required), i18n.T(ctx, "Required field"), []selectcomp.ItemData{{Value: "true", Label: i18n.T(ctx, "Required")}, {Value: "false", Label: i18n.T(ctx, "Optional")}}, nil)
			</label>
		</div>
		<label data-form-field-options hidden?={ field.Type!="select" }>
			{ i18n.T(ctx,"Options — one per line") }
			<textarea class="site-input" name="field_options" rows="3" maxlength="4000">
				{ strings.Join(field.Options,"\n") }
			</textarea>
		</label>
	</div>
}

templ FormEntries(site, csrf string, f store.Form, entries []store.FormEntry, page, total int, mail string) {
	@AdminLayout(site, i18n.T(ctx, "Forms"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "Submissions: ")+f.Name, total) {
@button.Button(button.Props{Href:formPath(f.ID)+"/entries/export",Variant:button.VariantOutline,Size:button.SizeSm,Attributes:templ.Attributes{"hx-boost":"false"}}) {
{ i18n.T(ctx,"Export CSV") }
}

			@button.Button(button.Props{Href: formPath(f.ID) + "/edit", Variant: button.VariantOutline, Size: button.SizeSm}) {
				{ i18n.T(ctx,"Form builder") }
			}
		}
		if mail=="queued" {
<p class="notice" role="status">{ i18n.T(ctx,"Notification queued.") }</p>
}
		if mail=="sent" {
			<p class="notice" role="status">{ i18n.T(ctx,"Notification sent.") }</p>
		}
		if mail=="failed" {
			<p class="notice notice-error" role="alert">{ i18n.T(ctx,"Could not send the notification. Check SMTP settings. The submission was saved.") }</p>
		}
		if len(entries)==0 {
			<section class="empty-state"><h2>{ i18n.T(ctx,"No submissions yet") }</h2><p>{ i18n.T(ctx,"Submissions will appear here when visitors send the form.") }</p></section>
		}
<form id="entry-delete-form" method="post" action={ templ.SafeURL(formPath(f.ID)+"/entries/delete") } class="content-bulk" hx-confirm={ i18n.T(ctx,"Permanently delete the selected submissions?") }>
<input type="hidden" name="csrf" value={ csrf }/>
<label class="content-selection"><input type="checkbox" data-select-all data-selection-form="entry-delete-form" aria-label={ i18n.T(ctx,"Select all submissions on this page") }/></label>
<span data-selection-count aria-live="polite">{ i18n.T(ctx,"Selected: 0") }</span>
@button.Button(button.Props{Type:button.TypeSubmit,Size:button.SizeSm,Variant:button.VariantOutline,Attributes:templ.Attributes{"data-bulk-action":true,"disabled":true}}) {
{ i18n.T(ctx,"Delete selected") }
}
</form>
		<div class="form-entries">
			for _,e:=range entries {
				@card.Card(card.Props{Class: "settings-panel form-entry px-4"}) {
					<div class="flex items-center justify-between gap-2 flex-wrap">
						<h2>
<input type="checkbox" name="selection" form="entry-delete-form" value={ strconv.FormatInt(e.ID,10) } aria-label={ i18n.T(ctx,"Select submission") }/>
							{ i18n.T(ctx,"Submission #")+strconv.FormatInt(e.ID,10) }
						</h2>
						<time class="field-help">
							{ contentDate(e.CreatedAt) }
						</time>
					</div>
					<dl>
						for _,value:=range e.Values {
							<div><dt>{ value.Label }</dt><dd>{ value.Value }</dd></div>
						}
					</dl>
					<div class="form-entry-mail">
						if e.MailStatus=="pending" || e.MailStatus=="retry" {
<span class="field-help">{ i18n.T(ctx,"Notification queued.") }</span>
} else if e.MailStatus=="sent" {
							<span class="field-help">{ i18n.T(ctx,"Email sent") }</span>
						} else {
							<span class="field-help">{ i18n.T(ctx,"Email not sent. Submission saved.") }</span>
							<form
								method="post"
								action={ templ.SafeURL(formPath(f.ID) + "/entries/" + strconv.FormatInt(e.ID, 10) + "/retry") }
							>
								<input type="hidden" name="csrf" value={ csrf }/>@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
	{ i18n.T(ctx,"Retry email") }
}
							</form>
						}
					</div>
				}
			}
		</div>
		<nav class="content-pagination" aria-label={ i18n.T(ctx, "Submission pages") }>
			<span>{ strconv.Itoa(total)+i18n.T(ctx," submissions") }</span>
			<div class="flex gap-2">
				if page>1 {
					@button.Button(button.Props{Href: formPath(f.ID) + "/entries?page=" + strconv.Itoa(page-1), Variant: button.VariantOutline, Size: button.SizeSm}) {
						{ i18n.T(ctx,"Back") }
					}
				}
				if page*25<total {
					@button.Button(button.Props{Href: formPath(f.ID) + "/entries?page=" + strconv.Itoa(page+1), Variant: button.VariantOutline, Size: button.SizeSm}) {
						{ i18n.T(ctx,"Next") }
					}
				}
			</div>
		</nav>
	}
}

templ PublicForm(f store.Form, csrf string, values url.Values) {
	<link rel="stylesheet" href="/assets/forms.css"/>
	<form
		class="gp-public-form"
		action={ templ.SafeURL("/forms/" + strconv.FormatInt(f.ID, 10)) }
		method="post"
	>
		<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="submission_key" value={ service.Token() }/><input
	type="hidden"
	name="version"
	value={ strconv.FormatInt(f.Version, 10) }
/>
		<h2>{ f.Name }</h2>
		<label class="gp-form-trap" aria-hidden="true">Website<input name="website" type="text" tabindex="-1" autocomplete="off"/></label>
		for i,field:=range f.Fields {
			<label class="gp-form-field">
				<span>
					{ field.Label }
					if field.Required {
						<span aria-hidden="true">*</span>
					}
				</span>
				switch field.Type {
					case "textarea":
						<textarea
							name={ formFieldName(i) }
							required?={ field.Required }
							maxlength="4000"
							rows="5"
						>
							{ values.Get(formFieldName(i)) }
						</textarea>
					case "select":
						<select
							name={ formFieldName(i) }
							required?={ field.Required }
						>
							<option value="">Выберите вариант</option>
							for _,option:=range field.Options {
								<option value={ option } selected?={ values.Get(formFieldName(i))==option }>{ option }</option>
							}
						</select>
					case "checkbox":
						<input
							type="checkbox"
							name={ formFieldName(i) }
							required?={ field.Required }
							value="Да"
							checked?={ values.Get(formFieldName(i))=="Да" }
						/>
					default:
						<input
							type={ field.Type }
							name={ formFieldName(i) }
							required?={ field.Required }
							maxlength="4000"
							value={ values.Get(formFieldName(i)) }
						/>
				}
			</label>
		}
		<button type="submit">{ f.Button }</button>
	</form>
}

templ PublicFormPage(f store.Form, csrf, message string, failed bool, values url.Values) {
	<!DOCTYPE html>
	<html lang="ru">
		<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{ f.Name }</title><link rel="stylesheet" href="/assets/forms.css"/></head>
		<body class="gp-form-page">
			<main>
				if message!="" {
					<p class="gp-form-message" role="status">{ message }</p>
				}
				if message==""||failed {
					@PublicForm(f, csrf, values)
				}
			</main>
		</body>
	</html>
}
