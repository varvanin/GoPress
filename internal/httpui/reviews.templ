package httpui

import (
	"strconv"
	"gopress/internal/i18n"
	"gopress/internal/service"
	"gopress/internal/store"
	"gopress/internal/ui/components/button"
	"gopress/internal/ui/components/card"
	"gopress/internal/ui/components/icon"
	"gopress/internal/ui/components/input"
)

templ ReviewsPage(site, csrf, zone string, items []store.ContentReview, postedID int64, comment, message string) {
	@AdminLayout(site, i18n.T(ctx, "Записи"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "Проверка публикаций"), len(items))
		if message != "" {
			<p class="notice notice-error" role="alert">{ i18n.T(ctx, message) }</p>
		}
		<div class="management-workspace">
			<div class="site-settings">
				if len(items) == 0 {
					<section class="empty-state">
						<span class="empty-icon">@icon.Icon("clipboard-list")(icon.Props{Class: "size-6"})</span>
						<h2>{ i18n.T(ctx, "Нет материалов на проверке") }</h2>
					</section>
				}
				for _, r := range items {
					@card.Card(card.Props{Class: "settings-panel review-card"}) {
						<div class="review-item-header">
							<h2 class="review-item-title">
								<a href={ templ.SafeURL("/admin/pages/" + strconv.FormatInt(r.PageID, 10) + "/edit") }>
									{ r.Title }
								</a>
							</h2>
							<p class="field-help">
								if r.Author != "" {
									{ r.Author } · 
								}
								{ "v" + strconv.FormatInt(r.Version, 10) + " · " + tableContentDate(r.RequestedAt, zone) }
							</p>
							<div class="review-item-links">
								<a class="context-link" href={ templ.SafeURL("/admin/pages/" + strconv.FormatInt(r.PageID, 10) + "/preview") } target="_blank" rel="noopener">{ i18n.T(ctx, "Предпросмотр") }</a>
								<a class="context-link" href={ templ.SafeURL("/admin/pages/" + strconv.FormatInt(r.PageID, 10) + "/edit") }>{ i18n.T(ctx, "Редактировать") }</a>
							</div>
						</div>
						if !r.Current {
							<p class="notice notice-warning" role="alert">
								{ i18n.T(ctx, "Черновик изменён после отправки. Нужна повторная отправка на проверку.") }
							</p>
						}
						if r.Comment != "" {
							<p class="field-help">{ r.Comment }</p>
						}
						if service.CanPublish(ctx) {
							<form method="post" action="/admin/posts/review" data-change-form class="review-form">
								<input type="hidden" name="csrf" value={ csrf }/>
								<input type="hidden" name="page_id" value={ strconv.FormatInt(r.PageID, 10) }/>
								<input type="hidden" name="version" value={ strconv.FormatInt(r.Version, 10) }/>
								<label>
									{ i18n.T(ctx, "Комментарий автору") }
									@input.Input(input.Props{
										Name: "comment",
										Value: reviewComment(r, postedID, comment),
										Attributes: templ.Attributes{"maxlength": "1000"},
									})
								</label>
								<div class="review-form-actions">
									@button.Button(button.Props{
										Type: button.TypeSubmit,
										Size: button.SizeSm,
										Disabled: !r.Current || r.Comment != "",
										Attributes: templ.Attributes{"name": "action", "value": "publish"},
									}) {
										<span>{ i18n.T(ctx, "Опубликовать") }</span>
									}
									@button.Button(button.Props{
										Type: button.TypeSubmit,
										Variant: button.VariantGhost,
										Size: button.SizeSm,
										Attributes: templ.Attributes{"name": "action", "value": "return"},
									}) {
										<span>{ i18n.T(ctx, "Вернуть автору") }</span>
									}
								</div>
							</form>
						}
					}
				}
			</div>
			<aside class="management-context">
				<h2>{ i18n.T(ctx, "Проверка публикаций") }</h2>
				<p>{ i18n.T(ctx, "Авторы отправляют черновики на проверку перед публикацией. Редакторы и администраторы могут одобрить материал или вернуть его на доработку.") }</p>
				<dl class="context-definitions">
					<div>
						<dt>{ i18n.T(ctx, "Опубликовать") }</dt>
						<dd>{ i18n.T(ctx, "Материал сразу становится доступен на сайте.") }</dd>
					</div>
					<div>
						<dt>{ i18n.T(ctx, "Вернуть автору") }</dt>
						<dd>{ i18n.T(ctx, "Материал возвращается в черновики вместе с комментарием.") }</dd>
					</div>
					<div>
						<dt>{ i18n.T(ctx, "Комментарий автору") }</dt>
						<dd>{ i18n.T(ctx, "Автор увидит комментарий при открытии материала в редакторе.") }</dd>
					</div>
				</dl>
			</aside>
		</div>
	}
}

func reviewComment(r store.ContentReview, id int64, comment string) string {
	if r.PageID == id {
		return comment
	}
	return r.Comment
}
