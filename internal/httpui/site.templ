package httpui

import "gopress/internal/i18n"

import "strconv"
import "gopress/internal/ui/components/select"
import "gopress/internal/store"
import "gopress/internal/ui/components/button"
import "gopress/internal/ui/components/icon"

templ MediaLibrary(site, baseURL, csrf string, files []store.MediaFile, total, page int, query, message string, selected *store.MediaFile, used, failed bool) {
	@AdminLayout(site, i18n.T(ctx, "Media library"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "Media library"), total)
		if message!="" {
			<p class={ "notice",templ.KV("notice-error",failed) } role="status">
				{ i18n.T(ctx, message) }
			</p>
		}
		<div class={ "library-layout",templ.KV("library-layout-empty",selected==nil) }>
			<section class="library-content">
				<form id="media-upload-form" action="/admin/media/upload" method="post" enctype="multipart/form-data" hx-encoding="multipart/form-data" class="library-upload">
					<input type="hidden" name="csrf" value={ csrf }/>
					<input id="library-file" type="file" name="file" accept="image/png,image/jpeg" required hidden aria-label={ i18n.T(ctx, "Upload image") }/>
					<div class="library-upload-icon" aria-hidden="true">
						@icon.Image(icon.Props{Class: "size-6"})
					</div>
					<div class="library-upload-body">
						<div class="library-upload-prompt">
							@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeSm, Attributes: templ.Attributes{"data-media-choose": true}}) {
								@icon.Plus()
								<span>{ i18n.T(ctx, "Upload image") }</span>
							}
							<span class="library-upload-or">{ i18n.T(ctx, "or drop it here") }</span>
						</div>
						<p class="library-upload-hint">{ i18n.T(ctx, "PNG / JPEG · up to 8 MiB and 16 MP") }</p>
					</div>
				</form>
				<div class="library-toolbar"><form method="get" action="/admin/media" class="library-search" role="search">@AdminSearch("media-search", query, i18n.T(ctx, "Search images…"))</form></div>
				<section class="library-grid" aria-label={ i18n.T(ctx, "Images") }>
					for _,file:=range files {
						<a class={ "library-tile",templ.KV("is-selected",mediaSelected(selected,file.Name)) } href={ templ.SafeURL(mediaFileURL(query, page, file.Name)) } data-media-name={ file.Name } hx-target="#media-inspector" hx-select="#media-inspector" hx-swap="outerHTML show:none" hx-push-url="true" aria-current={ activeTab(mediaSelected(selected, file.Name)) }>
							<img class="library-thumbnail" src={ "/uploads/" + file.Name+"?w=320" } alt={ file.Alt } loading="lazy"/>
							<span class="library-tile-title">
								{ mediaTitle(file) }
							</span>
							<span class="field-help">
								{ mediaFormat(file.Name)+" · "+mediaSize(file.Size) }
							</span>
						</a>
					}
					if len(files)==0 {
						<div class="library-empty">@icon.Image(icon.Props{Class: "size-7"})<h2>{ i18n.T(ctx,"No images yet") }</h2><p class="field-help">{ i18n.T(ctx,"Upload a file above or change your search.") }</p></div>
					}
				</section>
				if page>1||total>24 {
					<nav class="library-pagination" aria-label={ i18n.T(ctx, "Media library pages") }>
						if page>1 {
							<a href={ templ.SafeURL(mediaURL(query, page-1)) }>@icon.ArrowLeft(icon.Props{Class: "size-3.5"})<span>{ i18n.T(ctx,"Back") }</span></a>
						}
						<span>
							{ i18n.T(ctx,"Page ") }{ strconv.Itoa(page) }
						</span>
						if page*24<total {
							<a href={ templ.SafeURL(mediaURL(query, page+1)) }>{ i18n.T(ctx,"Next") } @icon.ArrowRight(icon.Props{Class: "size-3.5"})</a>
						}
					</nav>
				}
			</section>
			if selected!=nil {
				<aside id="media-inspector" class="library-inspector" aria-label={ i18n.T(ctx, "Image details") }>
					<div class="library-inspector-heading"><h2>{ mediaTitle(*selected) }</h2><a href={ templ.SafeURL("/uploads/" + selected.Name) } target="_blank" rel="noopener" title={ i18n.T(ctx, "Open original") } aria-label={ i18n.T(ctx, "Open original") }>@icon.ArrowUpRight(icon.Props{Class: "size-4"})</a></div>
					<img class="library-preview" src={ "/uploads/" + selected.Name } alt={ selected.Alt }/>
					<p class="field-help">
						{ mediaFormat(selected.Name)+" · "+mediaSize(selected.Size) }
					</p>
					<form action="/admin/media/details" method="post" class="library-details" data-change-form data-form-dirty={ strconv.FormatBool(failed) }>
						<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="name" value={ selected.Name }/><input type="hidden" name="revision" value={ selected.Revision }/><input type="hidden" name="return_q" value={ query }/><input type="hidden" name="return_page" value={ strconv.Itoa(page) }/>
						<label>{ i18n.T(ctx,"Name") }<input class="site-input" name="title" value={ selected.Title } maxlength="200"/></label>
						<label>{ i18n.T(ctx,"Alternative text") }<input class="site-input" name="alt" value={ selected.Alt } maxlength="500"/></label>
						<p class="field-help">{ i18n.T(ctx,"Describe what the image shows.") }</p>
						<label>
							{ i18n.T(ctx,"Caption") }
							<textarea class="site-input" name="caption" rows="2" maxlength="1000">
								{ selected.Caption }
							</textarea>
						</label>
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
							@icon.Check()<span>{ i18n.T(ctx,"Save details") }</span>
						}
					</form>
					<label class="library-file-url">{ i18n.T(ctx,"File URL") }<input class="site-input" type="text" readonly value={ baseURL + "/uploads/" + selected.Name }/></label>
					if used {
						<p class="library-used">@icon.LockKeyhole(icon.Props{Class: "size-3.5"})<span>{ i18n.T(ctx,"Used in content, site settings or modules. Deletion is unavailable.") }</span></p>
					} else {
						<form action="/admin/media/delete" method="post" hx-confirm={ i18n.T(ctx, "Permanently delete this image?") } class="library-delete">
							<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="name" value={ selected.Name }/>@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
	@icon.Icon("trash-2")(icon.Props{})<span>{ i18n.T(ctx,"Delete file") }</span>
}
						</form>
					}
				</aside>
			}
		</div>
	}
}

templ Menus(site, csrf string, menu store.Menu, pages []store.Page, message string, failed bool) {
	@AdminLayout(site, i18n.T(ctx, "Menus"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "Site menus"), -1) {
			@button.Button(button.Props{Type: button.TypeSubmit, Form: "site-menu-form", Size: button.SizeSm}) {
				@icon.Check()<span>{ i18n.T(ctx,"Save menu") }</span>
			}
		}
		if message!="" {
			<p class={ "notice",templ.KV("notice-error",failed) } role="status">
				{ i18n.T(ctx, message) }
			</p>
		}
		<nav class="content-list-tabs" aria-label={ i18n.T(ctx, "Menu location") }><a href={ templ.SafeURL("/admin/menus?position=header&lang="+menu.Language) } aria-current={ activeTab(menu.Position == "header") }>@icon.Icon("panel-top")(icon.Props{Class: "size-3.5"})<span>{ i18n.T(ctx,"Header") }</span></a><a href={ templ.SafeURL("/admin/menus?position=footer&lang="+menu.Language) } aria-current={ activeTab(menu.Position == "footer") }>@icon.Icon("panel-bottom")(icon.Props{Class: "size-3.5"})<span>{ i18n.T(ctx,"Footer") }</span></a></nav>
		<p class="field-help">{ i18n.T(ctx,"Use #section-contacts for a section on the current page, or /#section-contacts for the homepage. Set the anchor in the text editor.") }</p>
		if menu.Position=="header"&&menu.Version==0 {
			<p class="field-help">{ i18n.T(ctx,"The site currently shows the default menu: home and published pages. Saving replaces it with the list below.") }</p>
		}
		<form id="menu-language-form" action="/admin/menus" method="get">
			<input type="hidden" name="position" value={ menu.Position }/>
		</form>
		<form id="site-menu-form" action="/admin/menus" method="post" data-menu-form data-change-form data-form-dirty={ strconv.FormatBool(failed) } class="menu-builder">
			<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="language" value={ menu.Language }/><input type="hidden" name="position" value={ menu.Position }/><input type="hidden" name="version" value={ strconv.FormatInt(menu.Version, 10) }/>
			<aside class="menu-sidebar">
				<div class="menu-add-panel">
					<h2>{ i18n.T(ctx,"Add item") }</h2><label for="menu-page-choice">{ i18n.T(ctx,"Site page") }</label>
					@AdminSelect("menu-page-choice", "", "/", i18n.T(ctx, "Site page"), menuPageItems(ctx, pages), templ.Attributes{"data-menu-page": true})@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-menu-add-page": true}}) {
	@icon.Plus()<span>{ i18n.T(ctx,"Add to menu") }</span>
}
					<div class="menu-add-divider"></div>
					<p class="field-help">{ i18n.T(ctx,"For a post, external website or custom URL:") }</p>@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-menu-add": true}}) {
	@icon.Globe()<span>{ i18n.T(ctx,"Add custom link") }</span>
}
				</div>
				<div class="menu-language-panel">
					<h2>{ i18n.T(ctx, "Menu language") }</h2>
					<label for="menu-language">{ i18n.T(ctx, "Menu language") }</label>
					@AdminSelect("menu-language", "lang", menu.Language, i18n.T(ctx, "Menu language"), menuLanguageOptions(ctx), templ.Attributes{"form": "menu-language-form"})
					@button.Button(button.Props{Type: button.TypeSubmit, Form: "menu-language-form", Variant: button.VariantOutline, Size: button.SizeSm}) {
						<span>{ i18n.T(ctx, "Open") }</span>
					}
				</div>
			</aside>
			<section class="menu-structure" aria-label={ i18n.T(ctx, "Menu structure") }>
				<div class="menu-structure-heading"><h2>{ i18n.T(ctx,"Menu items") }</h2><span data-menu-status role="status"></span></div>
				<p class="field-help">{ i18n.T(ctx,"Add items from the left, arrange them with the arrows, then save the menu. Click an item to edit its label, URL or nesting.") }</p>
				<div data-menu-items class="menu-items">
					for _,item:=range menu.Items {
						@MenuRow(item)
					}
				</div>
				<p class="menu-empty field-help" data-menu-empty hidden?={ len(menu.Items)>0 }>{ i18n.T(ctx,"No links yet. Add a page or custom link from the left.") }</p>
				<p class="field-help">{ i18n.T(ctx,"An empty menu is hidden after saving.") }</p>
			</section>
			<template data-menu-template>
				@MenuRow(store.MenuItem{})
			</template>
		</form>
	}
}

templ MenuRow(item store.MenuItem) {
	<div class="menu-row" data-menu-row data-depth={ strconv.Itoa(item.Depth) }>
		<details class="menu-row-editor" open?={ item.Label=="" }>
			<summary>
				@icon.Icon("list-tree")(icon.Props{Class: "size-4"})
				<span class="menu-row-summary">
					<strong data-menu-label>
						if item.Label=="" {
							{ i18n.T(ctx,"New link") }
						} else {
							{ item.Label }
						}
					</strong>
				</span>@icon.ChevronRight(icon.Props{Class: "menu-row-chevron size-3.5"})
			</summary>
			<div class="menu-row-fields">
				<label>{ i18n.T(ctx,"Link label") }<input class="site-input" name="label" value={ item.Label } required maxlength="120" placeholder={ i18n.T(ctx, "About us") }/></label><label>{ i18n.T(ctx,"URL") }<input class="site-input" name="url" value={ item.URL } required maxlength="2048" placeholder={ i18n.T(ctx, "/about or https://…") }/></label>
				<label>
					{ i18n.T(ctx,"Position") }
					@AdminSelect("", "depth", strconv.Itoa(item.Depth), i18n.T(ctx, "Position"), []selectcomp.ItemData{{Value: "0", Label: i18n.T(ctx, "Top-level item")}, {Value: "1", Label: i18n.T(ctx, "Submenu item")}, {Value: "2", Label: i18n.T(ctx, "Nested submenu item")}}, nil)
				</label>
			</div>
		</details>
		<div class="menu-row-actions"><button type="button" data-menu-up title={ i18n.T(ctx, "Move up") } aria-label={ i18n.T(ctx, "Move up") }>@icon.ArrowDown(icon.Props{Class: "size-4 rotate-180"})</button><button type="button" data-menu-down title={ i18n.T(ctx, "Move down") } aria-label={ i18n.T(ctx, "Move down") }>@icon.ArrowDown(icon.Props{Class: "size-4"})</button><button type="button" data-menu-remove title={ i18n.T(ctx, "Remove link") } aria-label={ i18n.T(ctx, "Remove link") }>@icon.Icon("trash-2")(icon.Props{Class: "size-4"})</button></div>
	</div>
}

templ MediaPicker(files []store.MediaFile, total, page int, query, selected string) {
	<div class="picker-search"><label class="sr-only" for="picker-search">{ i18n.T(ctx,"Search media library") }</label><input id="picker-search" class="site-input" type="search" name="q" value={ query } placeholder={ i18n.T(ctx, "Search media library") } maxlength="200" hx-get="/admin/media/choices" hx-trigger="search, keyup changed delay:400ms" hx-target="#media-picker" hx-select="unset" hx-swap="innerHTML" hx-include="[name='cover']:checked"/></div>
	<p class="field-help">{ i18n.T(ctx,"Click an image to select a cover, or Insert to add it to the content.") }</p>
	@MediaFileChoices(files, selected)
	<nav class="picker-pagination" aria-label={ i18n.T(ctx, "Image pages") }>
		if page>1 {
			<button type="button" hx-get={ pickerURL(query, page-1) } hx-include="[name='cover']:checked" hx-target="#media-picker" hx-select="unset" hx-swap="innerHTML">@icon.ArrowLeft(icon.Props{Class: "size-3"})<span>{ i18n.T(ctx,"Back") }</span></button>
		}
		<span>{ strconv.Itoa(page) } · { strconv.Itoa(total) } { i18n.T(ctx,"files") }</span>
		if page*24<total {
			<button type="button" hx-get={ pickerURL(query, page+1) } hx-include="[name='cover']:checked" hx-target="#media-picker" hx-select="unset" hx-swap="innerHTML">{ i18n.T(ctx,"Next") } @icon.ArrowRight(icon.Props{Class: "size-3"})</button>
		}
	</nav>
}
