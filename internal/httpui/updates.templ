package httpui

import "gopress/internal/i18n"
import "gopress/internal/service"
import "gopress/internal/update"
import "gopress/internal/version"
import "gopress/internal/ui/components/button"
import "gopress/internal/ui/components/card"

templ UpdatesPage(site,csrf string,release update.Release,state service.UpdateState,configured bool,message string,failed bool){
 @AdminLayout(site,i18n.T(ctx,"Updates"),csrf){
  @AdminPageHeader(i18n.T(ctx,"Updates"),-1){
   <form method="post" action="/admin/updates/check">
    <input type="hidden" name="csrf" value={csrf}/>
    @button.Button(button.Props{Type:button.TypeSubmit,Size:button.SizeSm,Disabled:state.Pending()}){<span>{ i18n.T(ctx,"Check for updates") }</span>}
   </form>
  }
  @SettingsTabs("updates")
  if message!="" {
<p class={"notice",templ.KV("notice-error",failed)} role="status">{ i18n.T(ctx,message) }</p>
}
  <div class="management-workspace settings-workspace">
   <div class="site-settings">
    @card.Card(card.Props{Class:"settings-panel"}){
     <h2>{ i18n.T(ctx,"GoPress version") }</h2>
     <p>{ i18n.T(ctx,"Current version")+": "+version.Current }</p>
     if release.Version!="" {
      <p>{ i18n.T(ctx,"Last verified release")+": "+release.Version }</p>
      <p>{ i18n.T(ctx,"Minimum source version")+": "+release.MinimumVersion }</p>
      if release.Notes!="" {
<p class="whitespace-pre-wrap break-all">{release.Notes}</p>
}
      if updateAvailable(release)&&!state.Pending() {
       <form method="post" action="/admin/updates/install" hx-confirm={i18n.T(ctx,"Install the update? GoPress will create a backup and temporarily enable site maintenance.")}>
        <input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="version" value={release.Version}/>
        @button.Button(button.Props{Type:button.TypeSubmit,Variant:button.VariantOutline,Size:button.SizeSm}){<span>{ i18n.T(ctx,"Update") }</span>}
       </form>
      }
     }
    }
    @UpdateStatus(state)
   </div>
   <aside class="management-context">
    <h2>Docker / Dokploy</h2>
    if !configured {
     <p>{ i18n.T(ctx,"To install updates, connect Dokploy and configure the trusted release key on the server.") }</p>
    }
    <p>{ i18n.T(ctx,"Dokploy requires a Docker source, persistent /data, one replica and a pinned node.") }</p>
    <p>{ i18n.T(ctx,"Updates run only on request. A verified backup is created before replacing the container.") }</p>
    <p>{ i18n.T(ctx,"After startup, the new version and database are checked. If verification fails, maintenance remains enabled for safe recovery.") }</p>
    <a href="/admin/tools?tab=backups">{ i18n.T(ctx,"Backups") }</a>
   </aside>
  </div>
 }
}

templ UpdateStatus(state service.UpdateState){
 <div id="update-status" role="status" aria-live="polite"
 if updatePolling(state) {hx-get="/admin/updates/status" hx-trigger="every 5s" hx-target="this" hx-select="unset" hx-swap="outerHTML"}
 >
  if state.Phase!="" {
   @card.Card(card.Props{Class:"settings-panel"}){
    <h2>{ i18n.T(ctx,"Update status") }</h2>
    <p>{ i18n.T(ctx,updatePhase(state.Phase)) }</p>
    if state.Backup!="" {
<p>{ i18n.T(ctx,"Backup")+": "+state.Backup }</p>
}
    if state.PreviousImage!="" {
<p class="field-help break-all">{ i18n.T(ctx,"Previous image")+": "+state.PreviousImage }</p>
}
    if state.Pending()&&!updatePolling(state) {
<p>{ i18n.T(ctx,"Check the deployment in Dokploy and reload this page.") }</p>
}
   }
  }
 </div>
}
