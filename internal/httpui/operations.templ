package httpui

import "gopress/internal/ui/components/icon"

import "strconv"
import "gopress/internal/i18n"
import "gopress/internal/service"
import "gopress/internal/store"
import "gopress/internal/version"
import "gopress/internal/ui/components/button"
import "gopress/internal/ui/components/card"
import "gopress/internal/ui/components/input"
import "gopress/internal/ui/components/table"

templ Tools(site, csrf, tab string, active bool, backups []service.BackupInfo, d service.Diagnostics, settings store.Settings, events []store.AuditEvent, total, page int, message string, failed bool,schedule store.BackupSchedule) {
	@AdminLayout(site, i18n.T(ctx, "Tools"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "Tools"), -1) {
			if tab=="backups" {
				@button.Button(button.Props{Type: button.TypeSubmit, Form: "backup-create", Size: button.SizeSm}) {
					{ i18n.T(ctx,"Create backup") }
				}
			}
		}
		if message!="" {
			<p class={ "notice",templ.KV("notice-error",failed) } role="status">{ i18n.T(ctx,message) }</p>
		}
		<nav class="content-list-tabs" aria-label={ i18n.T(ctx, "Tools sections") }>
			<a href="/admin/tools" aria-current={ activeTab(tab == "backups") }>@icon.Icon("database")(icon.Props{Class:"size-3.5"})<span>{ i18n.T(ctx,"Backups") }</span></a>
			<a href="/admin/tools?tab=system" aria-current={ activeTab(tab == "system") }>@icon.Icon("wrench")(icon.Props{Class:"size-3.5"})<span>{ i18n.T(ctx,"System status") }</span></a>
			<a href="/admin/tools?tab=audit" aria-current={ activeTab(tab == "audit") }>@icon.Icon("clipboard-list")(icon.Props{Class:"size-3.5"})<span>{ i18n.T(ctx,"Audit log") }</span></a>
		</nav>
		switch tab {
			case "system":
				<div class="system-workspace site-settings">
					@card.Card(card.Props{Class: "settings-panel px-4"}) {
						<h2>{ i18n.T(ctx,"Maintenance mode") }</h2>
						<p class="field-help">{ i18n.T(ctx,"In maintenance mode the public site returns 503. Content changes and background jobs are paused. Sign-in and tools remain available.") }</p>
						<form method="post" action="/admin/tools/maintenance">
							<input type="hidden" name="csrf" value={ csrf }/>
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"name": "enabled", "value": strconv.FormatBool(!active)}}) {
								if active {
									{ i18n.T(ctx,"Disable maintenance") }
								} else {
									{ i18n.T(ctx,"Enable maintenance") }
								}
							}
						</form>
					}
					@card.Card(card.Props{Class: "settings-panel px-4"}) {
						<h2>{ i18n.T(ctx,"Diagnostics") }</h2>
						<dl class="diagnostics-grid"><div><dt>SQLite</dt><dd>{ i18n.T(ctx,"Check passed") }</dd></div><div><dt>{ i18n.T(ctx,"Database schema") }</dt><dd>{ strconv.Itoa(d.Schema) }</dd></div><div><dt>{ i18n.T(ctx,"Database size") }</dt><dd>{ storageSize(d.DatabaseBytes) }</dd></div><div><dt>{ i18n.T(ctx,"Free disk space") }</dt><dd>{ storageSize(int64(d.FreeBytes)) }</dd></div><div><dt>{ i18n.T(ctx,"Users") }</dt><dd>{ strconv.Itoa(d.Users) }</dd></div><div><dt>{ i18n.T(ctx,"Site content") }</dt><dd>{ strconv.Itoa(d.Pages) }</dd></div><div><dt>{ i18n.T(ctx,"Submissions") }</dt><dd>{ strconv.Itoa(d.Entries) }</dd></div></dl>
					}
					@card.Card(card.Props{Class: "settings-panel tools-wide"}) {
						<h2>{ i18n.T(ctx,"Update and rollback") }</h2>
						<p>{ "GoPress "+version.Current }</p>
						<p class="field-help">{ i18n.T(ctx,"Create and download a backup before updating. Enable maintenance, stop the process, replace the binary, run migrate and doctor, then start the site. To roll back, restore the previous application version together with a verified data backup. The web process never replaces the binary.") }</p>
					}
				</div>
			case "audit":
				<div class="audit-workspace">
					<section class="audit-panel tools-wide">
						<div class="audit-heading">
							<h2>{ i18n.T(ctx,"Audit log") } <span class="content-count">{ strconv.Itoa(total) }</span></h2>
							<details class="audit-retention">
								<summary>{ i18n.T(ctx,"Retention") }</summary>
								<form method="post" action="/admin/tools/retention" class="mail-test-form">
									<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="version" value={ strconv.FormatInt(settings.Version, 10) }/>
									<label>{ i18n.T(ctx,"Audit retention, days") }<input type="number" class="site-input" name="days" min="1" max="3650" required value={ strconv.Itoa(settings.AuditRetentionDays) }/></label>
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
										{ i18n.T(ctx,"Save") }
									}
								</form>
							</details>
						</div>
						if len(events)==0 {
							<div class="tool-empty"><h3>{ i18n.T(ctx,"No events yet") }</h3><p>{ i18n.T(ctx,"User sign-ins, content changes and settings actions appear here. Actions before logging was enabled cannot be recovered.") }</p></div>
						}
						if len(events)>0 {
							<div class="content-table audit-table">
								@table.Table() {
									@table.Header() {
										@table.Row() {
											@table.Head() {
												{ i18n.T(ctx,"Time") }
											}
											@table.Head() {
												{ i18n.T(ctx,"User") }
											}
											@table.Head() {
												{ i18n.T(ctx,"Action") }
											}
											@table.Head() {
												{ i18n.T(ctx,"Object") }
											}
										}
									}
									@table.Body() {
										for _,e:=range events {
											@table.Row() {
												@table.Cell() {
													{ auditDate(ctx,e.At,settings.Site.Timezone) }
												}
												@table.Cell() {
													{ auditActor(ctx,e) }
												}
												@table.Cell() {
													<span>{ auditAction(ctx,e.Action) }</span>
												}
												@table.Cell() {
													{ auditObject(ctx,e) }
												}
											}
										}
									}
								}
							</div>
							<nav class="content-pagination">
								<span></span>
								<div class="flex gap-2">
									if page>1 {
										@button.Button(button.Props{Href: "/admin/tools?tab=audit&page=" + strconv.Itoa(page-1), Variant: button.VariantOutline, Size: button.SizeSm}) {
											{ i18n.T(ctx,"Back") }
										}
									}
									if page*50<total {
										@button.Button(button.Props{Href: "/admin/tools?tab=audit&page=" + strconv.Itoa(page+1), Variant: button.VariantOutline, Size: button.SizeSm}) {
											{ i18n.T(ctx,"Next") }
										}
									}
								</div>
							</nav>
						}
					</section>
				</div>
			default:
				<div class="management-workspace site-settings">
					<div>
                        @BackupSchedulePanel(csrf,settings.Site.Timezone,schedule,failed)
						@card.Card(card.Props{Class: "settings-panel"}) {
							<h2>{ i18n.T(ctx,"Backups") }</h2>
							<p class="field-help">{ i18n.T(ctx,"The backup includes the database, uploads and templates, excluding email secrets. A copy of the current site is made before restoration; all sessions will be revoked.") }</p>
							<form id="backup-create" method="post" action="/admin/tools/backups/create">
								<input type="hidden" name="csrf" value={ csrf }/>
							</form>
							<details class="tool-import">
								<summary>{ i18n.T(ctx,"Import backup") }</summary>
								<form method="post" action="/admin/tools/backups/import" enctype="multipart/form-data" hx-encoding="multipart/form-data" class="mail-test-form">
									<input type="hidden" name="csrf" value={ csrf }/><label>{ i18n.T(ctx,"Backup ZIP archive — up to 1 GiB") }<input type="file" name="backup_file" accept=".zip,application/zip" required class="site-input"/></label>
									@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
										{ i18n.T(ctx,"Import backup") }
									}
								</form>
							</details>
							if len(backups)==0 {
								<div class="tool-empty"><h3>{ i18n.T(ctx,"No backups yet") }</h3><p>{ i18n.T(ctx,"Create the first backup using the button above or import a ZIP archive.") }</p></div>
							}
							for _,b:=range backups {
								<article class="backup-row">
									<div><strong>{ b.ID }</strong>
 if b.Automatic {
 <span class="field-help">{ i18n.T(ctx,"Scheduled") }</span>
 }
 <span class="field-help">{ contentDate(b.At)+" · "+storageSize(b.Bytes) }</span></div>
									<div class="backup-actions">
										@button.Button(button.Props{Href: "/admin/tools/backups/" + b.ID + "/download", Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"hx-boost": "false"}}) {
											{ i18n.T(ctx,"Download") }
										}
										<form method="post" action="/admin/tools/backups/verify">
											<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="backup" value={ b.ID }/>
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
												{ i18n.T(ctx,"Verify") }
											}
										</form>
										<form method="post" action="/admin/tools/backups/delete" hx-confirm={ i18n.T(ctx, "Delete this backup?") }>
											<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="backup" value={ b.ID }/>
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
												{ i18n.T(ctx,"Delete") }
											}
										</form>
									</div>
									if active {
										<form method="post" action="/admin/tools/backups/restore" class="mail-test-form" hx-confirm={ i18n.T(ctx, "Restore the site from this backup? The current site will be preserved in another backup. You will need to sign in again.") }>
											<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="backup" value={ b.ID }/>
											<label>
												{ i18n.T(ctx,"Type RESTORE to confirm") }
												@input.Input(input.Props{Name: "confirm", Required: true, Attributes: templ.Attributes{"pattern": "RESTORE", "autocomplete": "off"}})
											</label>
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
												{ i18n.T(ctx,"Restore") }
											}
										</form>
									}
								</article>
							}
						}
					</div>
					<aside class="management-context">
						<h2>{ i18n.T(ctx,"Site restoration") }</h2>
						<ol><li>{ i18n.T(ctx,"Enable maintenance in system status.") }</li><li>{ i18n.T(ctx,"Select a verified backup and confirm restoration.") }</li><li>{ i18n.T(ctx,"Check the site and disable maintenance.") }</li></ol>
						<p>{ i18n.T(ctx,"The current site is backed up before restoration. You will need to sign in again afterwards.") }</p>
						<a class="context-link" href="/admin/tools?tab=system">{ i18n.T(ctx,"System status") }</a>
					</aside>
				</div>
		}
	}
}


templ BackupSchedulePanel(csrf,zone string,value store.BackupSchedule,failed bool) {
 @card.Card(card.Props{Class:"settings-panel"}) {
 <h2>{ i18n.T(ctx,"Automatic backups") }</h2>
 <form action="/admin/tools/backups/schedule" method="post" data-change-form data-form-dirty={ boolString(failed) }>
 <input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="version" value={ strconv.FormatInt(value.Version,10) }/>
 <label class="settings-checkbox"><input type="checkbox" name="enabled" value="true" checked?={ value.Enabled }/>{ i18n.T(ctx,"Create a backup daily") }</label>
 <div class="backup-schedule-fields">
 <label>{ i18n.T(ctx,"Start hour") }@input.Input(input.Props{Name:"hour",Type:"number",Value:strconv.Itoa(value.Hour),Required:true,Attributes:templ.Attributes{"min":"0","max":"23"}})</label>
 <label>{ i18n.T(ctx,"Automatic copies to keep") }@input.Input(input.Props{Name:"keep",Type:"number",Value:strconv.Itoa(value.Keep),Required:true,Attributes:templ.Attributes{"min":"1","max":"30"}})</label>
 </div>
 <p class="field-help">{ zone+" · "+i18n.T(ctx,"The schedule does not delete manual backups.") }</p>
 if value.LastAttempt>0 {
 <p class="field-help">{ i18n.T(ctx,"Last attempt: ")+tableContentDate(value.LastAttempt,zone) }</p>
 }
 if value.LastSuccess>0 {
 <p class="field-help">{ i18n.T(ctx,"Last successful backup: ")+tableContentDate(value.LastSuccess,zone) }</p>
 }
 if value.Failed {
 <p class="notice notice-error" role="status">{ i18n.T(ctx,"Automatic backup did not complete. Check disk space and the server log.") }</p>
 }
 @button.Button(button.Props{Type:button.TypeSubmit,Variant:button.VariantOutline,Size:button.SizeSm}) {<span>{ i18n.T(ctx,"Save schedule") }</span>}
 </form>
 }
}
