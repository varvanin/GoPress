package httpui

import "gopress/internal/i18n"

import "gopress/internal/ui/components/button"
import "gopress/internal/ui/components/input"

templ System(title, csrf string) {
 @AuthLayout(title) {
  <form method="post" class="auth-form">
   <input type="hidden" name="csrf" value={ csrf }/>
   <div class="field"><label for="email">Email</label>@input.Input(input.Props{ID:"email",Name:"email",Type:"email",Required:true,Placeholder:"name@example.com",Attributes:templ.Attributes{"autocomplete":"username"}})</div>
   <div class="field"><label for="password">{ i18n.T(ctx,"Password") }</label>@input.Input(input.Props{ID:"password",Name:"password",Type:"password",Required:true,Placeholder:i18n.T(ctx,"Enter password"),Attributes:templ.Attributes{"autocomplete":"current-password"}})</div>
   <div class="field"><label for="second-factor-code">{ i18n.T(ctx,"2FA code or recovery code") }</label>@input.Input(input.Props{ID:"second-factor-code",Name:"code",Attributes:templ.Attributes{"autocomplete":"one-time-code","maxlength":"64"}})</div>
   @button.Button(button.Props{Type:button.TypeSubmit,Size:button.SizeSm,Class:"w-full"}) { <span>{ i18n.T(ctx,"Sign in") }</span> }
  </form>
  <a href="/forgot-password" class="auth-recovery-link">{ i18n.T(ctx,"Forgot password?") }</a>
 }
}

templ AuthLayout(title string) {
	<!DOCTYPE html>
	<html lang={ i18n.Language(ctx) } class="dark">
		<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{ i18n.T(ctx,title) } · GoPress</title><script src="/assets/admin-theme.js"></script><link rel="stylesheet" href="/assets/admin.css"/></head>
		<body class="style-nova gp-admin gp-auth auth-page auth-simple">
			@AdminThemeToggle(true)
 <main class="auth-shell">
				<a class="auth-logo" href="/" aria-label="GoPress"><img src="/assets/gopress.svg" width="2720" height="510" alt="GoPress"/></a>
				<section class="auth-card" aria-labelledby="auth-title">
					<h1 id="auth-title">{ i18n.T(ctx,title) }</h1>
					{ children... }
				</section>
			</main>
		</body>
	</html>
}
