package httpui

import "strconv"
import "gopress/internal/i18n"
import "gopress/internal/store"
import "gopress/internal/ui/components/button"
import "gopress/internal/ui/components/card"
import "gopress/internal/ui/components/input"
import "gopress/internal/ui/components/table"
import "gopress/internal/ui/components/icon"
import selectcomp "gopress/internal/ui/components/select"

templ Users(site, csrf string, users []store.User, total, page int) {
	@AdminLayout(site, i18n.T(ctx, "Users"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "Users"), total) {
			@button.Button(button.Props{Href: "/admin/users/new", Size: button.SizeSm}) {
				{ i18n.T(ctx,"Create user") }
			}
		}
		<div class="management-workspace">
			<div>
				<div class="content-table users-table">
					@table.Table() {
						@table.Header() {
							@table.Row() {
								@table.Head() {
									{ i18n.T(ctx,"User") }
								}
								@table.Head() {
									{ i18n.T(ctx,"Role") }
								}
								@table.Head() {
									{ i18n.T(ctx,"State") }
								}
								@table.Head(table.HeadProps{Class: "text-right"}) {
									<span class="sr-only">{ i18n.T(ctx,"Actions") }</span>
								}
							}
						}
						@table.Body() {
							for _,u:=range users {
								@table.Row() {
									@table.Cell() {
										<div class="page-cell">
											<span class="document-icon">@icon.Icon("users")(icon.Props{Class: "size-4"})</span>
											<div class="user-identity">
												<a class="page-title" href={ templ.SafeURL("/admin/users/" + strconv.FormatInt(u.ID, 10) + "/edit") }>{ u.Email }</a>
												if currentUser(ctx,u.ID) {
													<span class="user-self">{ i18n.T(ctx,"You") }</span>
												}
												if u.Name!="" {
													<span class="field-help">{ u.Name }</span>
												}
											</div>
										</div>
									}
									@table.Cell() {
										<span class="user-role">{ i18n.T(ctx,roleLabel(u.Role)) }</span>
									}
									@table.Cell() {
										<span class="user-status" data-blocked={ strconv.FormatBool(u.Blocked) }>
											if u.Blocked {
												{ i18n.T(ctx,"Blocked") }
											} else {
												{ i18n.T(ctx,"Active") }
											}
										</span>
									}
									@table.Cell() {
										<div class="content-row-actions">
											@button.Button(button.Props{Href: "/admin/users/" + strconv.FormatInt(u.ID, 10) + "/edit", Variant: button.VariantGhost, Size: button.SizeIconSm, Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "Edit"), "title": i18n.T(ctx, "Edit")}}) {
												@icon.PenLine(icon.Props{Class: "size-4"})
											}
										</div>
									}
								}
							}
						}
					}
				</div>
				<nav class="content-pagination" aria-label={ i18n.T(ctx, "User list pages") }>
					<span></span>
					<div class="flex gap-2">
						if page>1 {
							@button.Button(button.Props{Href: "/admin/users?page=" + strconv.Itoa(page-1), Variant: button.VariantOutline, Size: button.SizeSm}) {
								{ i18n.T(ctx,"Back") }
							}
						}
						if page*25<total {
							@button.Button(button.Props{Href: "/admin/users?page=" + strconv.Itoa(page+1), Variant: button.VariantOutline, Size: button.SizeSm}) {
								{ i18n.T(ctx,"Next") }
							}
						}
					</div>
				</nav>
			</div>
			<aside class="management-context">
				@UserRoleGuide()
			</aside>
		</div>
	}
}

templ UserEditor(site, csrf string, u store.User, message string, failed bool) {
	@AdminLayout(site, i18n.T(ctx, "Users"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "User"), -1) {
			@button.Button(button.Props{Href: "/admin/users", Variant: button.VariantOutline, Size: button.SizeSm}) {
				{ i18n.T(ctx,"Back") }
			}
            if currentUser(ctx,u.ID) {
            @button.Button(button.Props{Href:"/admin/account/security",Variant:button.VariantOutline,Size:button.SizeSm}) {<span>{ i18n.T(ctx,"Security and sessions") }</span>}
            }
			@button.Button(button.Props{Type: button.TypeSubmit, Form: "user-form", Size: button.SizeSm}) {
				{ i18n.T(ctx,"Save") }
			}
		}
		if message!="" {
			<p class="notice notice-error" role="alert">{ i18n.T(ctx,message) }</p>
		}
		<div class="management-workspace">
			<div>
				<form id="user-form" action="/admin/users/save" method="post" class="site-settings user-settings" data-change-form data-form-dirty={ strconv.FormatBool(failed) }>
					<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="id" value={ strconv.FormatInt(u.ID, 10) }/><input type="hidden" name="version" value={ strconv.FormatInt(u.Version, 10) }/>
					@card.Card(card.Props{Class: "settings-panel px-4"}) {
						<h2>{ i18n.T(ctx,"User details") }</h2>
						<label>
							Email
							@input.Input(input.Props{Name: "email", Type: "email", Value: u.Email, Required: true, Attributes: templ.Attributes{"maxlength": "254"}})
						</label>
						<label>{ i18n.T(ctx,"Name") } @input.Input(input.Props{Name: "name", Value: u.Name, Attributes: templ.Attributes{"maxlength": "120"}})</label>
						<label>{ i18n.T(ctx,"Password") } @input.Input(input.Props{Name: "password", Type: "password", Required: u.ID == 0, Attributes: templ.Attributes{"autocomplete": "new-password", "minlength": "12", "maxlength": "72"}})</label>
						<h2>{ i18n.T(ctx,"Site access") }</h2>
						<label>
							{ i18n.T(ctx,"Role") }
							@AdminSelect("user-role", "role", u.Role, i18n.T(ctx, "Role"), []selectcomp.ItemData{{Value: "admin", Label: i18n.T(ctx, "Administrator")}, {Value: "editor", Label: i18n.T(ctx, "Editor")}, {Value: "author", Label: i18n.T(ctx, "Author")}}, nil)
						</label>
						<label>
							{ i18n.T(ctx,"State") }
							@AdminSelect("user-blocked", "blocked", strconv.FormatBool(u.Blocked), i18n.T(ctx, "State"), []selectcomp.ItemData{{Value: "false", Label: i18n.T(ctx, "Active")}, {Value: "true", Label: i18n.T(ctx, "Blocked")}}, nil)
						</label>
						<p class="field-help">{ i18n.T(ctx,"Leave the password blank to keep it. Updating a user revokes their sessions. The last active administrator cannot be blocked.") }</p>
					}
				</form>
			</div>
			<aside class="management-context">
				@UserRoleGuide()
				<p>{ i18n.T(ctx,"Editing a user revokes their sessions. Server checks protect the last administrator.") }</p>
			</aside>
		</div>
	}
}

templ Account(site, csrf string, u store.User, message string, failed bool) {
	@AdminLayout(site, i18n.T(ctx, "My profile"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "My profile"), -1) {
            @button.Button(button.Props{Href:"/admin/account/security",Variant:button.VariantOutline,Size:button.SizeSm}) {<span>{ i18n.T(ctx,"Security and sessions") }</span>}
			@button.Button(button.Props{Type: button.TypeSubmit, Form: "account-password-form", Size: button.SizeSm}) {
				{ i18n.T(ctx,"Change password") }
			}
		}
		if message!="" {
			<p class="notice notice-error" role="alert">{ i18n.T(ctx,message) }</p>
		}
		<form id="account-password-form" method="post" action="/admin/account/password" class="site-settings user-settings" data-change-form>
			<input type="hidden" name="csrf" value={ csrf }/>
			@card.Card(card.Props{Class: "settings-panel px-4"}) {
				<h2>{ u.Email }</h2>
				<p class="field-help">{ i18n.T(ctx,roleLabel(u.Role)) }</p>
				<label>{ i18n.T(ctx,"Current password") } @input.Input(input.Props{Name: "old_password", Type: "password", Required: true, Attributes: templ.Attributes{"autocomplete": "current-password"}})</label>
				<label>{ i18n.T(ctx,"New password") } @input.Input(input.Props{Name: "password", Type: "password", Required: true, Attributes: templ.Attributes{"autocomplete": "new-password", "minlength": "12", "maxlength": "72"}})</label>
				<label>{ i18n.T(ctx,"Repeat password") } @input.Input(input.Props{Name: "password_confirm", Type: "password", Required: true, Attributes: templ.Attributes{"autocomplete": "new-password", "minlength": "12", "maxlength": "72"}})</label>
			}
		</form>
	}
}

templ Recovery(csrf, token, message string, reset, failed bool) {
 @AuthLayout("Восстановление доступа") {
				if message!="" {
					<p class={ "notice",templ.KV("notice-error",failed) } role="status">{ i18n.T(ctx,message) }</p>
				}
				<form method="post" class="auth-form">
					<input type="hidden" name="csrf" value={ csrf }/>
					if reset {
						<input type="hidden" name="token" value={ token }/>
						<label>{ i18n.T(ctx,"New password") } @input.Input(input.Props{Name: "password", Type: "password", Required: true, Attributes: templ.Attributes{"autocomplete": "new-password", "minlength": "12", "maxlength": "72"}})</label>
						<label>{ i18n.T(ctx,"Repeat password") } @input.Input(input.Props{Name: "password_confirm", Type: "password", Required: true, Attributes: templ.Attributes{"autocomplete": "new-password", "minlength": "12", "maxlength": "72"}})</label>
					} else {
						<label>
							Email
							@input.Input(input.Props{Name: "email", Type: "email", Required: true, Attributes: templ.Attributes{"autocomplete": "email", "maxlength": "254"}})
						</label>
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						{ i18n.T(ctx,"Continue") }
					}
				</form><a href="/login" class="auth-recovery-link">{ i18n.T(ctx,"Sign in") }</a>
 }
}

templ UserRoleGuide() {
	<h2>{ i18n.T(ctx,"Roles and access") }</h2>
	<dl class="context-definitions">
		<div><dt>{ i18n.T(ctx,"Administrator") }</dt><dd>{ i18n.T(ctx,"Manages the site, users, settings and backups.") }</dd></div>
		<div><dt>{ i18n.T(ctx,"Editor") }</dt><dd>{ i18n.T(ctx,"Edits and publishes content from all authors. Cannot manage site settings.") }</dd></div>
		<div><dt>{ i18n.T(ctx,"Author") }</dt><dd>{ i18n.T(ctx,"Works with their own posts and files. An editor or administrator publishes them.") }</dd></div>
	</dl>
}
