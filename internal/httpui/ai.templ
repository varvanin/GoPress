package httpui

import "strconv"
import "gopress/internal/i18n"
import "gopress/internal/service"
import "gopress/internal/ui/components/button"
import "gopress/internal/ui/components/card"
import "gopress/internal/ui/components/input"
import "gopress/internal/ui/components/icon"
import selectcomp "gopress/internal/ui/components/select"

templ AIPage(site, csrf string, value service.AISettings, configured bool, message string, failed, dirty bool) {
 @AdminLayout(site,i18n.T(ctx,"AI"),csrf) {
  @AdminPageHeader(i18n.T(ctx,"AI"),-1) {
   @button.Button(button.Props{Type:button.TypeSubmit,Form:"ai-settings-form",Size:button.SizeSm}) {
 { i18n.T(ctx,"Save settings") }
 }
  }
  @SettingsTabs("ai")
  if message!="" {
 <p class={"notice",templ.KV("notice-error",failed)} role="status">{ i18n.T(ctx,message) }</p>
 }
  <div class="management-workspace settings-workspace">
   <div class="site-settings">
    <form id="ai-settings-form" method="post" action="/admin/ai/settings" data-change-form data-form-dirty={strconv.FormatBool(dirty)}>
     <input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="version" value={value.Version}/>
     @card.Card(card.Props{Class:"settings-panel"}) {
      <h2>OpenRouter</h2>
      <label>{ i18n.T(ctx,"OpenRouter API key") }
       @input.Input(input.Props{Name:"key",Type:"password",Attributes:templ.Attributes{"autocomplete":"new-password","maxlength":"4096"}})
      </label>
      if configured {
       <p class="field-help">{ i18n.T(ctx,"Key saved. Leave this field empty to keep it.") }</p>
       <label class="settings-checkbox"><input type="checkbox" name="clear_key" value="1"/>{ i18n.T(ctx,"Remove API key") }</label>
      }
      <label>{ i18n.T(ctx,"Model") }
       @input.Input(input.Props{Name:"model",Value:value.Model,Required:true,Placeholder:"openrouter/auto",Attributes:templ.Attributes{"maxlength":"200","autocomplete":"off"}})
      </label>
      <p class="field-help">{ i18n.T(ctx,"Enter an OpenRouter model ID. Cost depends on the model and your account.") }</p>
     }
    </form>
   </div>
   <aside class="management-context">
    <h2>{ i18n.T(ctx,"Writing assistant") }</h2>
    <p class="field-help">{ i18n.T(ctx,"Open a page or post and expand AI. Describe the task, review the result and insert the text.") }</p>
    <p class="field-help">{ i18n.T(ctx,"The task and selected context are sent to OpenRouter. The key stays on the server outside normal backups.") }</p>
    <a href="https://openrouter.ai/settings/keys" target="_blank" rel="noopener noreferrer">{ i18n.T(ctx,"Get API key") }</a>
   </aside>
  </div>
 }
}

templ EditorAI() {
 @card.Card(card.Props{Class:"editor-panel"}) {
  <details data-editor-ai>
   @EditorPanelSummary(i18n.T(ctx,"AI"),icon.Icon("bot"))
   <div class="editor-panel-body">
    <label for="editor-ai-action">{ i18n.T(ctx,"Action") }</label>
    @AdminSelect("editor-ai-action","ai_action","generate",i18n.T(ctx,"Action"),[]selectcomp.ItemData{
    {Value:"generate",Label:i18n.T(ctx,"Write text")},{Value:"rewrite",Label:i18n.T(ctx,"Rewrite selection")},{Value:"shorten",Label:i18n.T(ctx,"Shorten selection")},{Value:"continue",Label:i18n.T(ctx,"Continue selection")},{Value:"translate",Label:i18n.T(ctx,"Translate original into current language")},{Value:"seo",Label:i18n.T(ctx,"Suggest SEO")},},nil)
    <label>{ i18n.T(ctx,"AI task") }
     <textarea class="input ai-prompt" rows="4" maxlength="2000" data-ai-prompt placeholder={i18n.T(ctx,"Describe the topic, structure and writing style.")}></textarea>
    </label>
    <label class="settings-checkbox"><input type="checkbox" data-ai-context/>{ i18n.T(ctx,"Include existing text") }</label>
    <p class="field-help">{ i18n.T(ctx,"The task and title are sent to OpenRouter. Selection actions, translation and SEO also send the relevant text.") }</p>
    @button.Button(button.Props{Variant:button.VariantOutline,Size:button.SizeSm,Attributes:templ.Attributes{"data-ai-generate":true}}) {
 { i18n.T(ctx,"Generate") }
 }
    <p class="field-help" role="status" aria-live="polite" data-ai-status></p>
    <div data-ai-result hidden>
     <label>{ i18n.T(ctx,"Result") }<textarea class="input ai-output" rows="8" readonly data-ai-output></textarea></label>
     @button.Button(button.Props{Variant:button.VariantOutline,Size:button.SizeSm,Attributes:templ.Attributes{"data-ai-insert":true}}) {
 { i18n.T(ctx,"Append to text") }
 }
    </div>
    @button.Button(button.Props{Variant:button.VariantGhost,Size:button.SizeSm,Attributes:templ.Attributes{"data-ai-undo":true,"hidden":true}}) {<span>{ i18n.T(ctx,"Undo AI changes") }</span>}
   </div>
  </details>
 }
}
