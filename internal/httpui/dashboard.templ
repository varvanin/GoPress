package httpui

import "gopress/internal/i18n"

import "strconv"
import "gopress/internal/store"
import "gopress/internal/ui/components/button"
import "gopress/internal/ui/components/icon"

templ Dashboard(site store.Site, csrf string, data store.DashboardData, appearance store.Appearance, theme string,attention []AttentionItem) {
	@AdminLayout(site.Title, i18n.T(ctx, "Overview"), csrf) {
		@AdminPageHeader(i18n.T(ctx, "Overview"), -1) {
			@button.Button(button.Props{Href: "/admin/pages/new", Variant: button.VariantOutline, Size: button.SizeSm}) {
				@icon.Plus()<span>{ i18n.T(ctx,"New page") }</span>
			}
			@button.Button(button.Props{Href: "/admin/posts/new", Size: button.SizeSm}) {
				@icon.Plus()<span>{ i18n.T(ctx,"New post") }</span>
			}
		}
        <a class="context-link" href="/admin/setup">{ i18n.T(ctx,"Getting started") }</a>
        if len(attention)>0 {
        <section class="dashboard-panel" data-dashboard-attention><h2>{ i18n.T(ctx,"Needs attention") }</h2><ul class="dashboard-upcoming">
        for _,item:=range attention {
        <li><a href={ templ.SafeURL(item.URL) }>{ i18n.T(ctx,item.Label) }</a>
        if item.Count>0 {
        <span>{ strconv.Itoa(item.Count) }</span>
        }
        </li>
        }
        </ul></section>
        }
		<div class="gp-dashboard-grid">
			@DashboardMetric(i18n.T(ctx, "Pages"), data.Pages.Total, icon.FileText) {
				<span>
					{ i18n.T(ctx,"Published ") }{ strconv.Itoa(data.Pages.Published) }
				</span><a href="/admin/pages">{ i18n.T(ctx,"Back to list") } @icon.ArrowRight(icon.Props{Class: "size-3"})</a>
			}
			@DashboardMetric(i18n.T(ctx, "Posts"), data.Posts.Total, icon.Icon("newspaper")) {
				<span>
					{ i18n.T(ctx,"Published ") }{ strconv.Itoa(data.Posts.Published) }
				</span><a href="/admin/posts">{ i18n.T(ctx,"Back to list") } @icon.ArrowRight(icon.Props{Class: "size-3"})</a>
			}
			@DashboardMetric(i18n.T(ctx, "Drafts"), data.Pages.Drafts+data.Posts.Drafts, icon.PenLine) {
				<span>
					{ i18n.T(ctx,"Pages: ")+strconv.Itoa(data.Pages.Drafts)+i18n.T(ctx," · posts: ")+strconv.Itoa(data.Posts.Drafts) }
				</span>
			}
			@DashboardMetric(i18n.T(ctx, "Scheduled"), data.Scheduled, icon.Icon("clock")) {
				<span>{ i18n.T(ctx,"Upcoming publications below") }</span>
			}
		</div>
		<div class="dashboard-columns">
			<section class="dashboard-panel dashboard-recent">
				<div class="dashboard-panel-heading">
					<h2>{ i18n.T(ctx,"Recent changes") }</h2>
					<span class="field-help">
						{ site.Timezone }
					</span>
				</div>
				if len(data.Recent)>0 {
					<div class="content-table">@PageTable(data.Recent, csrf, site.Timezone)</div>
				} else {
					<div class="dashboard-empty">@icon.FileText(icon.Props{Class: "size-5"})<p>{ i18n.T(ctx,"No content yet. Create a page or post using the button above.") }</p></div>
				}
			</section>
			<aside class="dashboard-side">
				<section class="dashboard-panel">
					<div class="dashboard-panel-heading">
						<h2>{ i18n.T(ctx,"Upcoming publications") }</h2>
						<span class="content-count">
							{ strconv.Itoa(data.Scheduled) }
						</span>
					</div>
					if len(data.Upcoming)==0 {
						<p class="dashboard-empty-text">{ i18n.T(ctx,"Nothing scheduled yet. Set a publication date in the content editor.") }</p>
					} else {
						<ul class="dashboard-upcoming">
							for _,p:=range data.Upcoming {
								<li>
									<a href={ templ.SafeURL("/admin/pages/" + strconv.FormatInt(p.ID, 10) + "/edit") }>
										{ p.Title }
									</a>
									<span>
										{ tableContentDate(p.ScheduledAt,site.Timezone) }
									</span>
								</li>
							}
						</ul>
					}
				</section>
				<section class="dashboard-panel">
					<div class="dashboard-panel-heading"><h2>{ i18n.T(ctx,"Site") }</h2>@icon.Globe(icon.Props{Class: "size-4"})</div>
					<dl class="dashboard-site-facts">
						<div><dt>{ i18n.T(ctx,"Time zone") }</dt><dd>{ site.Timezone }</dd></div>
						<div>
							<dt>{ i18n.T(ctx,"URL") }</dt>
							<dd>
								{ site.BaseURL }
							</dd>
						</div>
						<div>
							<dt>{ i18n.T(ctx,"Template") }</dt>
							<dd>
								<a href="/admin/themes">
									{ theme }
								</a>
							</dd>
						</div>
						<div>
							<dt>{ i18n.T(ctx,"Indexing") }</dt>
							<dd>
								<a href="/admin/seo">
									if appearance.SEO.NoIndex {
										{ i18n.T(ctx,"Disabled") }
									} else {
										{ i18n.T(ctx,"Allowed") }
									}
								</a>
							</dd>
						</div>
						<div>
							<dt>{ i18n.T(ctx,"Media library") }</dt>
							<dd>
								<a href="/admin/media">
									{ strconv.FormatInt(data.MediaCount,10)+" · "+storageSize(data.MediaBytes) }
								</a>
							</dd>
						</div>
						<div>
							<dt>{ i18n.T(ctx,"In trash") }</dt>
							<dd>
								{ strconv.Itoa(data.Trashed) }
							</dd>
						</div>
					</dl>
				</section>
			</aside>
		</div>
	}
}

templ DashboardMetric(label string, value int, symbol func(...icon.Props) templ.Component) {
	<section class="dashboard-metric">
		<div class="dashboard-metric-label">
			@symbol(icon.Props{Class: "size-4"})
			<h2>
				{ i18n.T(ctx, label) }
			</h2>
		</div>
		<strong class="dashboard-metric-value">
			{ strconv.Itoa(value) }
		</strong>
		<div class="dashboard-metric-detail">
			{ children... }
		</div>
	</section>
}
