package httpui

import "strconv"
import "gopress/internal/i18n"
import "gopress/internal/store"
import "gopress/internal/ui/components/button"
import "gopress/internal/ui/components/card"
import "gopress/internal/ui/components/icon"
import selectcomp "gopress/internal/ui/components/select"

templ SEOPage(site, csrf string, value store.Appearance, details store.Site, tab, message string, failed bool) {
	@AdminLayout(site, "SEO", csrf) {
		@AdminPageHeader("SEO", -1) {
			@button.Button(button.Props{Type: button.TypeSubmit, Form: "site-seo-form", Size: button.SizeSm}) {
				@icon.Check()<span>{ i18n.T(ctx,"Сохранить") }</span>
			}
		}
		<a class="context-link" href="/admin/seo/redirects">{ i18n.T(ctx,"Перенаправления и 404") }</a>
		<nav class="content-list-tabs settings-tabs" aria-label="SEO" hx-target="#seo-panel" hx-select="#seo-panel" hx-swap="outerHTML show:none">
			<a data-seo-tab-link href="/admin/seo?tab=search" aria-current={ activeTab(tab == "search") }>@icon.Icon("search")(icon.Props{Class:"size-3.5"})<span>{ i18n.T(ctx,"Поиск") }</span></a>
			<a data-seo-tab-link href="/admin/seo?tab=index" aria-current={ activeTab(tab == "index") }>@icon.Icon("globe")(icon.Props{Class:"size-3.5"})<span>{ i18n.T(ctx,"Индексация") }</span></a>
			<a data-seo-tab-link href="/admin/seo?tab=social" aria-current={ activeTab(tab == "social") }>@icon.Icon("share-2")(icon.Props{Class:"size-3.5"})<span>{ i18n.T(ctx,"Соцсети") }</span></a>
			<a data-seo-tab-link href="/admin/seo?tab=schema" aria-current={ activeTab(tab == "schema") }>@icon.Icon("code-xml")(icon.Props{Class:"size-3.5"})<span>{ i18n.T(ctx,"Данные сайта") }</span></a>
			<a data-seo-tab-link href="/admin/seo?tab=files" aria-current={ activeTab(tab == "files") }>@icon.Icon("file-text")(icon.Props{Class:"size-3.5"})<span>{ i18n.T(ctx,"Файлы") }</span></a>
		</nav>
		<div id="seo-panel">
		if message!="" {
			<p class={ "notice",templ.KV("notice-error",failed) } role="status">{ i18n.T(ctx,message) }</p>
		}
		<div class="management-workspace seo-workspace">
			<form id="site-seo-form" method="post" action="/admin/seo" data-change-form data-form-dirty={ strconv.FormatBool(failed) } class="site-seo-form site-settings" data-seo-settings hx-target="#seo-panel" hx-select="#seo-panel" hx-swap="outerHTML show:none">
				<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="version" value={ strconv.FormatInt(value.Version, 10) }/><input type="hidden" name="tab" value={ tab }/>
				switch tab {
					case "search":
						@SEOPanel("Главная и название сайта") {
							@SEOInput("seo_title", "Заголовок в поиске", value.SEO.Title, site, 200)
							@SEOTextarea("seo_description", "Описание в поиске", value.SEO.Description, 500)
							<div class="settings-pair">@SEOInput("site_name", "Название сайта для поисковиков", value.SEOOptions.SiteName, site, 200)@SEOInput("alternate_name", "Альтернативное название", value.SEOOptions.AlternateName, "", 200)</div>
						}
						@SEOPanel("Правила заголовков") {
							@SEOInput("separator", "Разделитель", value.SEOOptions.Separator, "·", 5)
							@SEOInput("page_title", "Заголовки страниц", value.SEOOptions.PageTitle, "{title} {separator} {site}", 300)
							@SEOInput("post_title", "Заголовки записей", value.SEOOptions.PostTitle, "{title} {separator} {site}", 300)
							@SEOInput("category_title", "Заголовки категорий", value.SEOOptions.CategoryTitle, "{category} {separator} {site}", 300)
							@SEOInput("search_title", "Заголовок поиска", value.SEOOptions.SearchTitle, "{query} {separator} {site}", 300)
							<p class="field-help">{ i18n.T(ctx,"Переменные: {title}, {site}, {separator}, {page}, {category}, {query}. Индивидуальный SEO-заголовок материала имеет приоритет.") }</p>
							@SEOTextarea("description_fallback", "Запасное описание", value.SEOOptions.DescriptionFallback, 500)
							<p class="field-help">{ i18n.T(ctx,"Пустое поле использует описание материала или начало опубликованного текста.") }</p>
						}
					case "index":
						@SEOPanel("Индексация сайта") {
							@SEOCheck("noindex", "Запретить индексацию всего сайта", value.SEO.NoIndex)
							@SEOCheck("noindex_home", "Не индексировать главную", value.SEOOptions.NoIndexHome)
							@SEOCheck("noindex_pages", "Не индексировать страницы", value.SEOOptions.NoIndexPages)
							@SEOCheck("noindex_posts", "Не индексировать записи", value.SEOOptions.NoIndexPosts)
							@SEOCheck("noindex_categories", "Не индексировать категории", value.SEOOptions.NoIndexCategories)
							@SEOCheck("noindex_pagination", "Не индексировать страницы пагинации", value.SEOOptions.NoIndexPagination)
							<p class="field-help">{ i18n.T(ctx,"Закрытые от индексации материалы исключаются из sitemap. Поиск, предпросмотры и 404 всегда получают noindex.") }</p>
						}
						@SEOPanel("Директивы поисковых роботов") {
							@SEOCheck("nofollow", "Не переходить по ссылкам (nofollow)", value.SEOOptions.NoFollow)
							@SEOCheck("nosnippet", "Не показывать текстовый сниппет", value.SEOOptions.NoSnippet)
							@SEOCheck("noimageindex", "Не индексировать изображения страницы", value.SEOOptions.NoImageIndex)
							<div class="settings-pair">@SEOInput("max_snippet", "Длина сниппета (max-snippet)", value.SEOOptions.MaxSnippet, "-1", 6)@SEOInput("max_video_preview", "Превью видео, секунд (max-video-preview)", value.SEOOptions.MaxVideoPreview, "-1", 6)</div>
							<label>{ i18n.T(ctx,"Размер превью изображений") }@AdminSelect("seo-image-preview", "max_image_preview", value.SEOOptions.MaxImagePreview, i18n.T(ctx, "Размер превью изображений"), []selectcomp.ItemData{{Value: "", Label: i18n.T(ctx, "По умолчанию")}, {Value: "none", Label: i18n.T(ctx, "Не показывать")}, {Value: "standard", Label: i18n.T(ctx, "Стандартное")}, {Value: "large", Label: i18n.T(ctx, "Большое")}}, nil)</label>
							<p class="field-help">{ i18n.T(ctx,"Пусто — не добавлять директиву; -1 — без ограничения; 0 — запретить превью.") }</p>
							@SEOCheck("disable_canonical", "Не выводить canonical URL", value.SEOOptions.DisableCanonical)
							<p class="field-help">{ i18n.T(ctx,"Обычно canonical включён. Отдельный адрес можно задать в SEO-настройках материала.") }</p>
						}
					case "social":
						@SEOPanel("Карточки ссылок") {
							@SEOCheck("disable_og", "Отключить Open Graph", value.SEOOptions.DisableOpenGraph)
							@SEOCheck("disable_twitter", "Отключить карточки X / Twitter", value.SEOOptions.DisableTwitter)
							@SEOInput("default_image", "Изображение по умолчанию", value.SEOOptions.DefaultImage, "/uploads/social-cover.webp", 2048)
							<p class="field-help">{ i18n.T(ctx,"Абсолютный HTTP/HTTPS URL или путь /uploads/… Индивидуальное изображение материала важнее обложки; затем используется запасное изображение.") }</p>
							@SEOInput("social_title", "Заголовок главной для соцсетей", value.SEOOptions.SocialTitle, "", 200)
							@SEOTextarea("social_description", "Описание главной для соцсетей", value.SEOOptions.SocialDescription, 500)
							<div class="settings-pair">@SEOInput("og_locale", "Локаль Open Graph", value.SEOOptions.Locale, "ru_RU", 10)@SEOInput("twitter_site", "Аккаунт X / Twitter", value.SEOOptions.TwitterSite, "@account", 16)</div>
							<label>{ i18n.T(ctx,"Формат карточки X / Twitter") }@AdminSelect("seo-twitter-card", "twitter_card", value.SEOOptions.TwitterCard, i18n.T(ctx, "Формат карточки X / Twitter"), []selectcomp.ItemData{{Value: "", Label: i18n.T(ctx, "Автоматически")}, {Value: "summary", Label: "Summary"}, {Value: "summary_large_image", Label: "Summary large image"}}, nil)</label>
						}
					case "schema":
						@SEOPanel("Структурированные данные") {
							@SEOCheck("schema_enabled", "Формировать JSON-LD", value.SEOOptions.SchemaEnabled)
							<p class="field-help">{ i18n.T(ctx,"WebSite и издатель на главной; BlogPosting для записей; BreadcrumbList для материалов. Данные берутся из опубликованной версии.") }</p>
							<label>{ i18n.T(ctx,"Тип издателя") }@AdminSelect("seo-organization-type", "organization_type", value.SEOOptions.OrganizationType, i18n.T(ctx, "Тип издателя"), []selectcomp.ItemData{{Value: "", Label: i18n.T(ctx, "Не указывать")}, {Value: "Organization", Label: i18n.T(ctx, "Организация")}, {Value: "Person", Label: i18n.T(ctx, "Человек")}}, nil)</label>
							@SEOInput("organization_name", "Название организации или имя", value.SEOOptions.OrganizationName, "", 200)
							@SEOInput("logo_url", "URL логотипа", value.SEOOptions.LogoURL, "/uploads/logo.png", 2048)
							@SEOTextarea("social_profiles", "Официальные профили — по одному URL в строке", value.SEOOptions.SocialProfiles, 16384)
						}
						@SEOPanel("Подтверждение владения") {
							@SEOInput("google_verification", "Google Search Console", value.SEOOptions.GoogleVerification, "", 200)
							@SEOInput("bing_verification", "Bing Webmaster Tools", value.SEOOptions.BingVerification, "", 200)
							@SEOInput("yandex_verification", "Яндекс Вебмастер", value.SEOOptions.YandexVerification, "", 200)
							<p class="field-help">{ i18n.T(ctx,"Вставьте только значение content из метатега подтверждения, без HTML.") }</p>
						}
					case "files":
						@SEOPanel("Карта сайта") {
							@SEOCheck("disable_sitemap", "Отключить sitemap.xml", value.SEOOptions.DisableSitemap)
							@SEOCheck("sitemap_exclude_pages", "Исключить страницы из sitemap", value.SEOOptions.ExcludeSitemapPages)
							@SEOCheck("sitemap_exclude_posts", "Исключить записи из sitemap", value.SEOOptions.ExcludeSitemapPosts)
							@SEOCheck("sitemap_categories", "Добавлять категории в sitemap", value.SEOOptions.IncludeSitemapCategories)
							@SEOTextarea("sitemap_exclude_paths", "Исключённые пути — по одному в строке", value.SEOOptions.ExcludeSitemapPaths, 16384)
							<p class="field-help">{ i18n.T(ctx,"Точные пути: /about, /contacts. До 100 строк. Это исключение из sitemap, а не запрет индексации.") }</p>
						}
						@SEOPanel("Robots.txt и RSS") {
							@SEOTextarea("robots_text", "Собственный robots.txt", value.SEOOptions.RobotsText, 16384)
							<p class="field-help">{ i18n.T(ctx,"Пусто — стандартный robots.txt. Свой текст заменяет файл целиком; {site_url} подставляет адрес сайта. Disallow запрещает обход, но не гарантирует удаление из поиска.") }</p>
							@SEOCheck("disable_rss", "Отключить RSS-ленту", value.SEOOptions.DisableRSS)
						}
				}
			</form>
			<aside class="management-context seo-context">
				<section><h2>{ i18n.T(ctx,"Предпросмотр главной") }</h2><div class="seo-search-preview" data-seo-preview data-site={ details.Title } data-fallback-description={ value.HomeDescription }><span>{ details.BaseURL }</span><strong data-seo-preview-title>{ seoPreviewTitle(details,value) }</strong><p data-seo-preview-description>{ seoPreviewDescription(value) }</p></div><p>{ i18n.T(ctx,"Пример метаданных. Поисковик может выбрать другой заголовок и описание.") }</p></section>
				<section><h2>{ i18n.T(ctx,"Индивидуальные настройки") }</h2><p>{ i18n.T(ctx,"В редакторе страницы и записи доступны свои заголовок, описание, canonical, noindex, nofollow и карточка соцсетей.") }</p></section>
				<section><h2>{ i18n.T(ctx,"Файлы сайта") }</h2><nav class="seo-resource-links"><a href="/sitemap.xml" target="_blank" rel="noopener">Sitemap @icon.ArrowUpRight(icon.Props{Class: "size-3"})</a><a href="/robots.txt" target="_blank" rel="noopener">Robots.txt @icon.ArrowUpRight(icon.Props{Class: "size-3"})</a><a href="/rss.xml" target="_blank" rel="noopener">RSS @icon.ArrowUpRight(icon.Props{Class: "size-3"})</a></nav></section>
				if tab=="files" {
					<section><h2>{ i18n.T(ctx,"Текущий robots.txt") }</h2><pre class="seo-robots-preview">{ robotsContent(details,value) }</pre></section>
				}
			</aside>
		</div>
</div>
	}
}

templ SEOPanel(title string) {
	@card.Card(card.Props{Class: "settings-panel px-4"}) {
		<h2>{ i18n.T(ctx,title) }</h2>
		{ children... }
	}
}

templ SEOInput(name, label, value, placeholder string, limit int) {
	<label for={ "site-seo-" + name }><span class="seo-label-line"><span>{ i18n.T(ctx,label) }</span><span class="seo-field-count" data-seo-count={ name }>{ strconv.Itoa(len([]rune(value)))+" / "+strconv.Itoa(limit) }</span></span><input id={ "site-seo-" + name } class="site-input" name={ name } value={ value } placeholder={ placeholder } maxlength={ strconv.Itoa(limit) }/></label>
}

templ SEOTextarea(name, label, value string, limit int) {
	<label for={ "site-seo-" + name }><span class="seo-label-line"><span>{ i18n.T(ctx,label) }</span><span class="seo-field-count" data-seo-count={ name }>{ strconv.Itoa(len([]rune(value)))+" / "+strconv.Itoa(limit) }</span></span><textarea id={ "site-seo-" + name } class="site-input" name={ name } rows="4" maxlength={ strconv.Itoa(limit) }>{ value }</textarea></label>
}

templ SEOCheck(name, label string, value bool) {
	<label class="settings-checkbox"><input type="checkbox" name={ name } value="1" checked?={ value }/><span>{ i18n.T(ctx,label) }</span></label>
}
